{
    "build": {
        "target": ".",
        "tasks": [
            {
                "for":"hana",
                "src":"./asint_ais_model",
                "dest": "./asint_ais_model/src/gen",
                "options": {
                    "model": [
                        "./asint_ais_model",
                        "./asint_ais_backend",
                        "./asint_ais_analytics_backend"
                    ]
                }
            },
            {
                "for":"java-cf",
                "src":"./asint_ais_backend",
                "options": {
                    "model": [
                        "./asint_ais_model",
                        "./asint_ais_backend"
                    ]
                }
            },
            {
                "for":"java-cf",
                "src":"./asint_ais_event_layer",
                "options": {
                    "model": [
                        "./asint_ais_model",
                        "./asint_ais_backend"
                    ]
                }
            }
        ]
    },
    "hana": {
        "deploy-format": "hdbtable",
        "syntax": "hdi"
    },
    "folders": {
        "db": "./asint_ais_model",
        "srv": "./asint_ais_backend"
    },
    "roots": [
        "./asint_ais_model",
        "./asint_ais_backend"
    ],
    "requires": {
        "db": {
            "kind": "hana",
            "pool": {
                "max": 100,
                "min": 10
            }
        }
    }
}