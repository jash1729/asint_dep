{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/asint/event_layer/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "asint_ais_event_layer-api"
    },
    {
      "source": "^/asint/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "asint-ais-backend-api"
    },
    {
      "source": "^/workflow_api/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "AIS_WORKFLOW"
    },
    {
      "source": "^/bpa_api/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "AIS_BPA"
    },
    {
      "source": "^/feature_flag/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "asint-ais-feature_flag"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
