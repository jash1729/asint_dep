{
    "_version": "1.48.0",
    "sap.app": {
        "id": "com.asint.ais.mi.cml",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.3"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:basic",
            "version": "1.8.4",
            "toolsId": "2d57c713-e707-43e2-8293-fb32b10e5bd7"
        },
        "dataSources": {
            "masterService": {
                "uri": "/asint/odata/v4/api/v1/mi/cml/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            },
            "S4ValueHelpService":{
                "uri": "/asint/odata/v4/S4DataService/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            },
            "masterServiceCmlList": {
                "uri": "/asint/odata/v4/api/v1/mi/cmlList/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            },
            "attribute":{
                "uri": "model/attribute.json",
                "type": "JSON"
            },
            "indicator":{
                "uri": "model/indicator.json",
                "type": "JSON"
            },
            "picklist":{
                "uri": "model/picklist.json",
                "type": "JSON"
            },
            "picklistDetail":{
                "uri": "model/picklistDetail.json",
                "type": "JSON"
            },
            "equipmentTemplate":{
                "uri": "model/equipmentTemplate.json",
                "type": "JSON"
            },
            "UOMDesc":{
                "uri": "model/UOMDesc.json",
                "type": "JSON"
            },
            "objectDataModel":{
                "uri": "model/ObjectDataModel.json",
                "type": "JSON"
            }
        },
        "crossNavigation": {
            "inbounds": {
                "com-asint-ais-mi-cml-inbound": {
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    },
                    "semanticObject": "cml",
                    "action": "manage",
                    "title": "{{flpTitle}}",
                    "subTitle": "{{flpSubtitle}}",
                    "icon": "sap-icon://measuring-point",
                    "info": "Copyright © AsInt, Inc.",
                    "indicatorDataSource": {
                        "dataSource": "masterService",
                        "path": "CMLAssetOverviewList/$count",
                        "refresh": 1000
                    }
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": { 
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        },
        "fullWidth": true
    },
    "sap.ui5": {
        "services": {
			"ShellUIService": {
				"factoryName": "sap.ushell.ui5service.ShellUIService"
			}
		},
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.f": {},
                "sap.suite.ui.generic.template": {},
                "sap.ui.comp": {},
                "sap.ui.generic.app": {},
                "sap.ui.table": {},
                "sap.ushell": {},                
                "sap.viz":{},
                "sap.suite.ui.commons":{}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "com.asint.ais.mi.cml.i18n.i18n"
                }
            },
            "masterService": {
                "dataSource": "masterService",
                "preload": true,
                "settings": {
                    "autoExpandSelect": true,
                    "synchronizationMode": "None",
                    "operationMode": "Server"
                }
            },
            "masterServiceCmlList": {
                "dataSource": "masterServiceCmlList",
                "preload": true,
                "settings": {
                    "autoExpandSelect": true,
                    "synchronizationMode": "None",
                    "operationMode": "Server"
                }
            },
            "valueHelpService":{
                "dataSource":"S4ValueHelpService",
                "preload": true,
                "settings": {
                    "autoExpandSelect": true,
                    "synchronizationMode": "None",
                    "operationMode": "Server"
                }
            },
            "mMessage": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.asint.ais.mi.cml.i18n.message"
				}
			}
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ],
            "js":[
                {
                    "uri": "utils/jszip.js"
                }, 
                {
                    "uri": "utils/xlsx.js"
                }, 
                {
                    "uri": "utils/exceljs.min.js"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.f.routing.Router",
                "viewType": "XML",
                "async": true,
                "viewPath": "com.asint.ais.mi.cml.view",
                "controlAggregation": "pages",
                "controlId": "app",
                "clearControlAggregation": false
            },
            "routes": [
                {
                    "pattern": ":layout:",
                    "name": "nCMLList",      
                    "target": [
                        "tCMLList"
                    ]
                },                
                {
                    "pattern": "detail/{objectType}/{objectId}/cml/:locationId:",
                    "name": "nCMLDetail",                    
                    "target": [
                        "tCMLDetail"
                    ]                    
                }
            ],
            "targets": {
                "tCMLList": {
                    "viewPath": "com.asint.ais.mi.cml.view.list",
                    "viewName": "CMLList",
                    "viewId": "idCMLListPage",
                    "viewType": "XML",
                    "transition": "slide",
                    "clearControlAggregation": false
                },
                "tCMLDetail": {
                    "viewPath": "com.asint.ais.mi.cml.view.detail",
                    "viewName": "CMLDetail",
                    "viewId": "idCMLDetailPage",
                    "viewType": "XML",
                    "transition": "slide",
                    "clearControlAggregation": false
                }
            }
        },
        "rootView": {
            "viewName": "com.asint.ais.mi.cml.view.App",
            "type": "XML",
            "async": true,
            "id": "App"
        }
    },
    "sap.platform.cf": {
        "ui5VersionNumber": "1.120.32",
        "oAuthScopes": [
            "$XSAPPNAME.AIS_SUPER_ADMIN"
        ]
    },
    "sap.cloud": {
		"public": true,
		"service": "asint.ais"
	}
}