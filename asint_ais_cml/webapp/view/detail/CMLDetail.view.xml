<mvc:View
	controllerName="com.asint.ais.mi.cml.controller.detail.CMLDetail"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form"
	xmlns:svm="sap.ui.comp.smartvariants"
	xmlns:commons="sap.suite.ui.commons"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:viz.data="sap.viz.ui5.data"
	xmlns:t="sap.ui.table"
	xmlns:custom="com.asint.ais.mi.cml.control"
	xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<f:FlexibleColumnLayout layout="{mCMLModel>/data/detailPage/layout}">
		<f:beginColumnPages>
			<f:DynamicPage fitContent="true" preserveHeaderStateOnScroll="true"
				class="asintDynamicPage">
				<f:title>
					<f:DynamicPageTitle>
						<f:heading>
							<Title text="{mCMLModel>/data/detailPage/headerData/objectName}" />
						</f:heading>
						<f:actions>
							<Button hideIcon="false" hideText="false" text="Insights" type="Transparent" icon="{value: 'com/asint/ais/mi/cml/images/AIicon.png', formatter: 'sap.ui.require.toUrl'}" press="onPressAIRecommendation"  visible="{= ${mCMLModel>/metaData/featureFlag/CmlAiInsight} === '1'}" class="aiRecommendationButton" />
						</f:actions>
						<f:expandedContent>
							<Label text="{mCMLModel>/data/detailPage/headerData/displayId}" />
						</f:expandedContent>
						<f:snappedContent>
							<Label text="{mCMLModel>/data/detailPage/headerData/displayId}" />
						</f:snappedContent>
						<f:snappedTitleOnMobile>
							<Title text="{mCMLModel>/data/detailPage/headerData/displayId}" />
						</f:snappedTitleOnMobile>
					</f:DynamicPageTitle>
				</f:title>
				<f:header>
					<f:DynamicPageHeader pinnable="true">
						<l:HorizontalLayout allowWrapping="true">

							<l:VerticalLayout class="sapUiMediumMarginEnd">
								<HBox>
									<ObjectAttribute
										title="{i18n>asint.cml.overview.header.shortDescription.label}"
										text="{mCMLModel>/data/detailPage/headerData/objectDesc}"
										class="sapUiMediumMarginEnd" />
								</HBox>
							</l:VerticalLayout>

							<l:VerticalLayout class="sapUiMediumMarginEnd">
								<HBox>
									<ObjectAttribute
										title="{i18n>asint.cml.overview.header.objectType.label}"
										text="{= ${mCMLModel>/data/detailPage/headerData/objectType} === 'EQUI' ? 'Equipment' : 'Functional Location'}"
										class="sapUiMediumMarginEnd" />
								</HBox>
							</l:VerticalLayout>

							<l:VerticalLayout>
								<HBox>
									<ObjectAttribute
										title="{i18n>asint.cml.overview.header.modifiedOn.text}"
										text="{
										path: 'mCMLModel>/data/detailPage/headerData/modifiedAt',
										formatter: 'com.asint.ais.mi.cml.utility.Formatter.fnGetUIDate'
									}"
										class="sapUiMediumMarginEnd" />
								</HBox>
							</l:VerticalLayout>

						</l:HorizontalLayout>
					</f:DynamicPageHeader>
				</f:header>
				<f:content>
					<VBox>
						<Table id="idOverViewList" class="sapUiSmallMarginBottom"
							sticky="ColumnHeaders" alternateRowColors="true" growing="true"
							growingThreshold="10"
							items="{mCMLModel>/data/detailPage/summary}">
							<headerToolbar>
								<OverflowToolbar>
									<content>
										<Title text="CML Summary" level="H2" />
									</content>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column popinDisplay="Inline" minScreenWidth="Tablet"
									demandPopin="true" width="15%">
									<Text text="{i18n>asint.cml.overview.table.column.label.desc}" />
								</Column>
								<Column popinDisplay="Inline" minScreenWidth="Tablet"
									demandPopin="true" width="15%">
									<Text text="{i18n>asint.cml.overview.table.column.label.value}" />
								</Column>
								<Column popinDisplay="Inline" minScreenWidth="Tablet"
									demandPopin="true" width="45%">
									<Text
										text="{i18n>asint.cml.overview.table.column.label.location}" />
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
									 <ObjectIdentifier text="{mCMLModel>aggregatorHeaderCml/description}" />
									<ObjectIdentifier text="{mCMLModel>aggregatorHeaderCml/value}" />
									<HBox items="{mCMLModel>aggregatorDatasourceCml}" wrap="Wrap">
									<GenericTag text="{mCMLModel>locDesc}" design="StatusIconHidden" class="sapUiTinyMarginEnd" press="onPressCML">
										<ObjectNumber emphasized="false" number="{mCMLModel>locValue}" unit="{mCMLModel>uom}"/>
									</GenericTag>
									</HBox>
										<!-- <ObjectIdentifier
											text="{mCMLModel>aggregatorHeaderCml/aggregatorName}" />
										<ObjectIdentifier
											text="{mCMLModel>aggregatorHeaderCml/value}" />
										<HBox items="{mCMLModel>aggregatorDatasourceCml}"
											wrap="Wrap">
											<GenericTag text="{mCMLModel>locDesc}"
												design="StatusIconHidden" class="sapUiTinyMarginEnd"
												press="onCML">
												<ObjectNumber emphasized="false"
													number="{mCMLModel>locValue}"
													unit="{mCMLModel>uom}" />
											</GenericTag>
										</HBox> -->
									</cells>
								</ColumnListItem>
							</items>
						</Table>

						<f:FlexibleColumnLayout id="idInnerFCL"
							layout="{mCMLModel>/data/detailPage/cmlTable/analytics/layout}">
							<f:beginColumnPages>
								<f:DynamicPage fitContent="true">
									<f:header>
										<f:DynamicPageHeader pinnable="false">
											<HBox justifyContent="SpaceBetween">
												<VBox>
													<Title text="Analytics" />
												</VBox>
												<HBox>
													<Button icon="sap-icon://decline"
														tooltip="{i18n>asint.reusable.button.cancel.text}"
														press="onToggleBeginPage" />
												</HBox>
											</HBox>
										</f:DynamicPageHeader>
									</f:header>
									<f:content>
										<VBox id="idVizFrameCMLTable" height="500px">
											<VBox id="idVizFrameCMLTableButton" />
											<VBox id="idVizFrameCMLTableData"/>
										</VBox>
									</f:content>
								</f:DynamicPage>
							</f:beginColumnPages>

							<f:midColumnPages>
								<f:DynamicPage id="idCMLDetailInnerPage" fitContent="true">
									<f:content>
										<VBox id="idCMLTreeTable">
										</VBox>
									</f:content>
								</f:DynamicPage>
							</f:midColumnPages>
						</f:FlexibleColumnLayout>
						<!-- <t:TreeTable
							id="idAsintCMLOverallReading" class="classAsintCMLOverallReading"
							rows="{path:'mCMLModel>/data/detailPage/CMLs', parameters: {arrayNames:['categories']}}"
							selectionMode="MultiToggle"
							enableSelectAll="false"
							ariaLabelledBy="title" rowSelectionChange="onRowSelection"
							visibleRowCount="10" threshold="10" fixedColumnCount="1"
							rowActionCount="1" visibleRowCountMode="Fixed" minAutoRowCount="30" columnFreeze="1">
							<t:extension>
								<OverflowToolbar style="Clear">
									<Title
										text="{i18n>asint.cml.detail.page.overallReading.table.title} ({mCMLModel>/data/detailPage/overallReadingCount})"
										level="H2" />
									<SearchField class="sapUiMediumMarginBegin" placeholder="Search"
										value="{mCMLModel>/data/detailPage/sSearchText}"
										search="onSearchCML" width="15rem" />
									<ToolbarSpacer />
									<MenuButton type="Transparent" icon="sap-icon://group-2"
										visible="{mCMLModel>/data/userRoles/edit}" enabled="{mCMLModel>/data/detailPage/isGroupVisible}">
										<menu>
											<Menu itemSelected="onPressGroup">
												<MenuItem text="{i18n>asint.cml.detail.page.overallReading.table.group.assign}"
													key="Assign" />
												<MenuItem text="{i18n>asint.cml.detail.page.overallReading.table.group.unassign}"
													key="UnAssign" />
											</Menu>
										</menu>
									</MenuButton>
									<MenuButton type="Transparent" icon="sap-icon://duplicate"
										visible="{mCMLModel>/data/userRoles/edit}">
										<menu>
											<Menu itemSelected="onPressDuplicateCML">
												<MenuItem text="Copy to This Asset"
													key="Same Object" />
												<MenuItem text="Copy to New Asset"
													key="Different Object" />
												<MenuItem text="Paste" key="Paste"
													visible="{mCMLModel>/data/detailPage/copyPaste/visible/pasteButton}" />
											</Menu>
										</menu>
									</MenuButton>
									<Button icon="sap-icon://excel-attachment"
										id="idExcelExport" visible="true" press="onExcelExport" />
									<Button id="idFilterSetting"
										icon="sap-icon://filter"
										press="handleOpenSettingDialog"
										tooltip="{i18n>asint.cml.detail.toolbar.table.filter.button.text}" />
									<Button id="idTableP13nSettings"
										icon="sap-icon://action-settings"
										tooltip="{i18n>asint.cml.detail.toolbar.table.settings.button.text}" />
								</OverflowToolbar>
							</t:extension>
							<t:rowActionTemplate>
								<t:RowAction>
									<t:RowActionItem
										type="Navigation"
										visible="{= ${mCMLModel>rowType} === 'parentRow'}"
										press="onPressCML"
									/>
								</t:RowAction>
							</t:rowActionTemplate>
							<t:columns>
								<t:Column width="13rem" id="idObjectName"
									customData:p13nSettings="{
									metadata: {
										path: 'objectName',
										control: 'sap.m.ObjectStatus',
										value1: 'objectName',
										value2: 'objectType'
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.objectName}"
										wrapping="true" />
									<t:template>
										<ObjectStatus
											class="idParentRows"
											text="{mCMLModel>objectName}"
											icon="{= ${mCMLModel>objectType} === 'EQUI' ? 'sap-icon://machine' : ${mCMLModel>objectType} === 'FLOC' ? 'sap-icon://functional-location' : ''}"
											state="None"
										/>
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idCMLName"
									customData:p13nSettings="{
									metadata: {
										path: 'cmlName',
										control: 'sap.m.ObjectIdentifier',
										value1: 'cmlName',
										value2: 'cmlDescription'
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.cmlName}"
										wrapping="true" />
									<t:template>
										<ObjectIdentifier class="idParentRows"
											title="{mCMLModel>cmlName}"
											text="{mCMLModel>cmlDescription}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idCMLPosition"
									customData:p13nSettings="{
									metadata: {
										path: 'cmlPosition',
										control: 'sap.m.ObjectIdentifier',
										value1: 'cmlPosition',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.cmlPosition}"
										wrapping="true" />
									<t:template>
										<Text text="{mCMLModel>cmlPosition}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idCMLTemplateName"
									customData:p13nSettings="{
									metadata: {
										path: 'cmlTemplateName',
										control: 'sap.m.Text',
										value1: 'cmlTemplateName',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.cmlTemplateName}"
										wrapping="true" />
									<t:template>
										<Text text="{mCMLModel>cmlTemplateName}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idDate"
									customData:p13nSettings="{
									metadata: {
										path: 'dateTimeValue',
										control: 'sap.m.Text',
										value1: 'dateTimeValue',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.date}"
										wrapping="true" />
									<t:template>
										<Text text="{mCMLModel>date}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idTmin"
									customData:p13nSettings="{
									metadata: {
										path: 'tmin',
										control: 'sap.m.Text',
										value1: 'tmin',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.tMin} ({= ${mCMLModel>/data/UOM} === 'imperial' ? 'in' : 'mm'})"
										wrapping="true" />
									<t:template>
										<Text text="{mCMLModel>tmin}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idReading"
									customData:p13nSettings="{
									metadata: {
										path: 'reading',
										control: 'sap.m.ObjectStatus',
										value1: 'reading',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.readings} ({= ${mCMLModel>/data/UOM} === 'imperial' ? 'in' : 'mm'})"
										wrapping="true" />
									<t:template>
										<ObjectStatus class="classReading"
											text="{mCMLModel>reading}"
											icon="{mCMLModel>activeIconReading}"
											state="{= ${mCMLModel>activeColColorReading} === 'Danger' ? 'Error' : ${mCMLModel>activeColColorReading} === 'Warning' ? 'Warning' : ${mCMLModel>activeColColorReading} === 'Information' ? 'Information' : ${mCMLModel>activeColColorReading} === 'Indication08' ? 'Indication08' : 'None'}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idShortTermCorrisionRate"
									customData:p13nSettings="{
									metadata: {
										path: 'shortTermCorrisionRate',
										control: 'sap.m.Text',
										value1: 'shortTermCorrisionRate',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.shortCorrosion} ({= ${mCMLModel>/data/UOM} === 'imperial' ? 'in/year' : 'mm/year'})"
										wrapping="true" />
									<t:template>
										<ObjectStatus class="classCorrision"
											text="{mCMLModel>shortTermCorrisionRate}"
											icon="{mCMLModel>activeIconSortTerm}"
											state="{= ${mCMLModel>activeColColorSortTerm} === 'Danger' ? 'Error' : ${mCMLModel>activeColColorSortTerm} === 'Warning' ? 'Warning' : ${mCMLModel>activeColColorSortTerm} === 'Information' ? 'Information' : ${mCMLModel>activeColColorSortTerm} === 'Indication08' ? 'Indication08' : 'None'}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idLongTermCorrision"
									customData:p13nSettings="{
									metadata: {
										path: 'longTermCorrisionRate',
										control: 'sap.m.ObjectStatus',
										value1: 'longTermCorrisionRate',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.longCorrosion} ({= ${mCMLModel>/data/UOM} === 'imperial' ? 'in/year' : 'mm/year'})"
										wrapping="true" />
									<t:template>
										<ObjectStatus class="classCorrision"
											text="{mCMLModel>longTermCorrisionRate}"
											icon="{mCMLModel>activeIconLongTerm}"
											state="{= ${mCMLModel>activeColColorLongTerm} === 'Danger' ? 'Error' : ${mCMLModel>activeColColorLongTerm} === 'Warning' ? 'Warning' : ${mCMLModel>activeColColorLongTerm} === 'Information' ? 'Information' : ${mCMLModel>activeColColorLongTerm} === 'Indication08' ? 'Indication08' : 'None'}" />
									</t:template>
								</t:Column>
								<t:Column width="12rem" id="idHalfLife"
									customData:p13nSettings="{
									metadata: {
										path: 'halfLife',
										control: 'sap.m.Text',
										value1: 'halfLife',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.halfLife}"
										wrapping="true" />
									<t:template>
										<Text text="{mCMLModel>halfLife}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idRetirementDate"
									customData:p13nSettings="{
									metadata: {
										path: 'retirementDateTimeValue',
										control: 'sap.m.Text',
										value1: 'retirementDateTimeValue',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.retirementDate}"
										wrapping="true" />
									<t:template>
										<Text text="{mCMLModel>retirementDate}" />
									</t:template>
								</t:Column>
								<t:Column width="13rem" id="idCMLGroupName" visible="false"
									customData:p13nSettings="{
									metadata: {
										path: 'groupName',
										control: 'sap.m.Text',
										value1: 'groupName',
										value2: ''
									}
								}">
									<Label
										text="{i18n>asint.cml.detail.page.overallReading.table.label.CMLGroup}"
										wrapping="true" />
									<t:template>
										<Text text="{mCMLModel>groupName}" />
									</t:template>
								</t:Column>
							</t:columns>
						</t:TreeTable> -->
					</VBox>
				</f:content>
			</f:DynamicPage>
		</f:beginColumnPages>
		<f:midColumnPages>
			<NavContainer id="idMidColumnNavContainer" initialPage="idCMLDetailPage">
				<f:DynamicPage id="idCMLDetailPage" fitContent="true" class="asintDynamicPage">
					<f:title>
						<f:DynamicPageTitle>
							<f:heading>
								<Title text="{mCMLModel>/data/selectedCML/name}" />
							</f:heading>
							<f:expandedContent>
								<Label text="{mCMLModel>/data/selectedCML/displayId}" />
							</f:expandedContent>
							<f:snappedContent>
								<Label text="{mCMLModel>/data/selectedCML/displayId}" />
							</f:snappedContent>
							<f:snappedTitleOnMobile>
								<Title text="{mCMLModel>/data/selectedCML/displayId}" />
							</f:snappedTitleOnMobile>
							<f:actions>
								<Button type="Transparent"
									text="{i18n>asint.cml.detail.page.editheader.text}"
									press="onEditHeader" visible="{mCMLModel>/data/userRoles/edit}" />
								<Button type="Transparent" text="Save" press="onPressSave"
									visible="{mCMLModel>/data/userRoles/edit}" />
								<Button type="Emphasized" text="Calculate" press="onPressCalculate"
									visible="{mCMLModel>/data/userRoles/edit}" />
							</f:actions>
							<f:navigationActions>
								<Button type="Transparent" icon="sap-icon://full-screen"
									press="handleFullScreen" tooltip="Enter Full Screen Mode"
									visible="{mCMLModel>/metaData/CMLTabSection/viewFullScreen}" />
								<Button type="Transparent" icon="sap-icon://exit-full-screen"
									press="handleExitFullScreen" tooltip="Exit Full Screen Mode"
									visible="{mCMLModel>/metaData/CMLTabSection/exitFullScreen}" />
								<Button type="Transparent" icon="sap-icon://decline" press="handleClose"
									tooltip="Close column"
									visible="{mCMLModel>/metaData/CMLTabSection/closeScreen}" />
							</f:navigationActions>
						</f:DynamicPageTitle>
					</f:title>
					<f:header>
						<f:DynamicPageHeader pinnable="true">
							<l:HorizontalLayout allowWrapping="true">
								<l:VerticalLayout class="sapUiMediumMarginEnd">
									<ObjectAttribute title="Short Description"
										text="{mCMLModel>/data/selectedCML/locDesc}" />
								</l:VerticalLayout>
								<l:VerticalLayout class="sapUiMediumMarginEnd">
									<ObjectAttribute title="CML Template"
										text="{mCMLModel>/data/selectedCML/cmlTemplate}" />
								</l:VerticalLayout>
								<l:VerticalLayout class="sapUiMediumMarginEnd">
									<ObjectAttribute title="Object Type"
										text="{mCMLModel>/data/selectedCML/objectType}" />
								</l:VerticalLayout>
								<l:VerticalLayout class="sapUiMediumMarginEnd">
									<ObjectAttribute title="Modified On"
										text="{parts: [{path:'mCMLModel>/data/selectedCML/modifiedAt'}], formatter:'com.asint.ais.mi.cml.utility.Formatter.fnGetUIDate'}" />
								</l:VerticalLayout>
							</l:HorizontalLayout>
						</f:DynamicPageHeader>
					</f:header>
					<f:content>
						<IconTabBar id="iconTabBar" class="sapUiResponsiveContentPadding"
							select="fnOnSelectIconFilter" backgroundDesign="Transparent">
						</IconTabBar>
					</f:content>
				</f:DynamicPage>
				<f:DynamicPage id="idAIRecommendationPage" fitContent="true" class="asintDynamicPage">
					<f:title>
						<f:DynamicPageTitle>
							<f:heading>
                                <HBox alignItems="Center">
                                    <Image src="{value: 'com/asint/ais/mi/cml/images/AIicon.png', formatter: 'sap.ui.require.toUrl'}" class="customHeaderIcon" />
                                    <Title text="{i18n>asint.ai.recommendations.title}" class="sapUiTinyMarginBegin customTitle"/>
                                </HBox>
                            </f:heading>
							<f:navigationActions>
							    <Button type="Emphasized" text="{i18n>asint.ai.recommendations.refresh.button}" press="onRefreshInsights" />
								<Button icon="sap-icon://download"  press="onDownloadPDF"/>
								<Button type="Transparent" icon="sap-icon://full-screen" press="handleFullScreen" visible="{mCMLModel>/metaData/CMLTabSection/viewFullScreen}" />
						        <Button type="Transparent" icon="sap-icon://exit-full-screen" press="handleExitFullScreen" visible="{mCMLModel>/metaData/CMLTabSection/exitFullScreen}" />
								<Button type="Transparent" icon="sap-icon://decline" press="handleCloseAi"/>
							</f:navigationActions>
						</f:DynamicPageTitle>
					</f:title>
					<f:header>
						<f:DynamicPageHeader pinnable="true">
							<l:HorizontalLayout allowWrapping="true">
								<l:VerticalLayout class="sapUiMediumMarginEnd">
									<ObjectAttribute title="{i18n>asint.cml.overview.header.shortDescription.label}"
										text="{mCMLModel>/data/detailPage/headerData/objectDesc}" />
								</l:VerticalLayout>
								<l:VerticalLayout class="sapUiMediumMarginEnd">
									<ObjectAttribute title="{i18n>asint.cml.overview.header.objectType.label}"
										text="{= ${mCMLModel>/data/detailPage/headerData/objectType} === 'EQUI' ? 'Equipment' : 'Functional Location'}" />
								</l:VerticalLayout>
							</l:HorizontalLayout>
						</f:DynamicPageHeader>
					</f:header>
					<f:content>
						<VBox class="sapUiMediumMargin" id="idPDFContent">
							<List id="idAISectionList" class="aiSectionList" items="{path:'mCMLModel>/data/aiSections', factory:'.fnAISectionFactory'}" showSeparators="None"/>
						</VBox>
					</f:content>
				</f:DynamicPage>
			</NavContainer>
		</f:midColumnPages>
	</f:FlexibleColumnLayout>
</mvc:View>