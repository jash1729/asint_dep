<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">
    <Dialog title="{i18n>asint.cml.detail.page.editheader.text}" titleAlignment="Center" contentWidth="40%" draggable="true">
    <f:SimpleForm editable="true" columnsM="1" columnsL="1" columnsXL="1" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" layout="ResponsiveGridLayout" maxContainerCols="1">
        <f:content>
            <Label required="true" text="{i18n>asint.cml.list.newCML.label.name}"/>
            <Input type="Text" value="{mCMLModel>/data/editHeader/name}"/>
            <Label required="true" text="{i18n>asint.cml.list.newCML.label.desc}"/>
            <Input type="Text" value="{mCMLModel>/data/editHeader/locDesc}"/>
        </f:content>
    </f:SimpleForm>
    <buttons>
        <Button type="Emphasized" text="{i18n>asint.reusable.button.save.text}" press="onUpdateHeader"/>
        <Button type="Transparent" text="{i18n>asint.reusable.button.cancel.text}" press="onCancelHeader"/>
    </buttons>
    </Dialog>
</core:FragmentDefinition>