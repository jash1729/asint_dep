<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
    <Dialog
        title="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.dialog.title}"
        contentWidth="70%"
        contentHeight="70%"
    >
        <content>
            <VBox justifyContent="Start" alignItems="Start">
                <u:FileUploader id="idfileUploader" width="80%" sameFilenameAllowed="false" buttonText="Browse" 
                change="onFileBrowse" style="Emphasized" class="sapUiResponsiveMargin"
                placeholder="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.dialog.fileUploader.placeHolder}"
                />
                <Table sticky="HeaderToolbar,ColumnHeaders" id="idFileUploaderTable"
                    items="{
                                path: 'mCMLModel>/data/createInspection/importedSelectedCml'
                               }"
                    mode="MultiSelect" selectionChange="onTableSelectionChange" alternateRowColors="true"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <content>
                                <ToolbarSpacer />
                                <SearchField width="30%" search="handleSearchField"
                                />
                                <Button icon="sap-icon://action-settings" press="onPressSettingsMTable"
                                />
                            </content>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column width="25%">
                            <Title text="{parts:[{path:'i18n>asint.cml.list.newInspection.dialog.wizard.reading.table.column1.text'}]}"
                            customData:tableSettings="CML Template"
                            />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Title customData:tableSettings="Reading"
                            text="{parts:[{path:'i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.dialog.Table.column2.text'},{path:'mCMLModel>/data/UOM'}], formatter:'com.asint.ais.mi.cml.utility.Formatter.fnFormatCmlReading'}"
                            />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Title customData:tableSettings="recentReading"
                            text="{parts:[{path:'i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.dialog.Table.column3.text'},{path:'mCMLModel>/data/UOM'}], formatter:'com.asint.ais.mi.cml.utility.Formatter.fnFormatCmlReading'}"
                            />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Title customData:tableSettings="readingDate"
                            text="{i18n>asint.cml.list.newInspection.dialog.wizard.reading.table.column3.text}"
                            />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Title customData:tableSettings="Status"
                            text="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.dialog.Table.column4.text}"
                            />
                        </Column>
                        <Column width="20%" minScreenWidth="Tablet" demandPopin="true">
                            <Title customData:tableSettings="Reason"
                            text="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.dialog.Table.column5.text}" 
                            />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <ObjectIdentifier title="{mCMLModel>CML Template}" text="{mCMLModel>CML Name} - {mCMLModel>CML Description}"
                                />
                                <Text
                                    text="{parts:[{path:'mCMLModel>Reading'},{path:'mCMLModel>recentReading'}], formatter:'com.asint.ais.mi.cml.utility.Formatter.fnGrowthDetection'}"
                                />
                                <Text text="{mCMLModel>recentReading}" />
                                <DatePicker value="{mCMLModel>Reading Date}"  editable="false" />
                                <Text
                                    text="{parts:[{path:'mCMLModel>Status'}], formatter:'com.asint.ais.mi.cml.utility.Formatter.fnSuccessFailure'}"
                                />
                                <Text text="{mCMLModel>Reason}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <buttons>
            <Button text="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.dialog.button.title}"
                enabled="{mCMLModel>/data/createInspection/enableImportbtn}" type="Emphasized" press="onImportButtonPress"
            />
            <Button
                text="{i18n>asint.reusable.button.cancel.text}" press="onFileUploadClose"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
