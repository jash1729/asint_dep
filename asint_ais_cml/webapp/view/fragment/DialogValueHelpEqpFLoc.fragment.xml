<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="Equipment/Functional Location" horizontalScrolling="false"
		afterOpen="fnDialogAfterOpenLocationAssign" contentWidth="50%" contentHeight="50%">
		<Table id="idDialogEqpFLoc" growing="true" growingScrollToLoad="true" growingThreshold="20" mode="SingleSelectMaster"
			noDataText="No Data" popinLayout="GridLarge" alternateRowColors="true"
			items="{ path : 'mCMLModel>/data/listPage/equipmentLocationList/valueHelpData'}" selectionChange="onSelectEquipmentLocation">
			<headerToolbar>
				<OverflowToolbar design="Transparent" height="70px">
					<content>
						<VBox width="100%">
							<SearchField id="idSearchEquFlocCreate" liveChange="onSearchLiveChangeCreate" 
								placeholder="Search" search="onSearchLiveChangeCreate" width="100%"></SearchField>
							
							<SegmentedButton id="idSegment" width="100%" selectionChange="onSelectSegment" selectedKey="EQP">
								<items>
									<SegmentedButtonItem icon="sap-icon://machine" text="Equipment" key="EQP"/>
									<SegmentedButtonItem icon="sap-icon://functional-location" text="Functional Location" key="FLOC"/>
								</items>
							</SegmentedButton>
						</VBox>
					</content>				
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column id="idDialogEqpFlocName">
					<Text text="{mCMLModel>/data/listPage/create/cml/selectedSegment}"></Text>
				</Column>
			</columns>
			<items>
				<ColumnListItem>
					<cells>
						<ObjectIdentifier title="{mCMLModel>objectName}" text="{mCMLModel>objectDesc}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<buttons>
			<Button text="Cancel" press="onValueDialogCancel" visible="true"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition> 