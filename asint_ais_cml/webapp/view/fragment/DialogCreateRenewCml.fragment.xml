<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">

    <Dialog title="{i18n>asint.cml.detail.renewCml.dialog.title}"
            titleAlignment="Center"
            contentWidth="60%"
            draggable="true"
            resizable="true">

        <f:SimpleForm editable="true"
                      columnsM="1" columnsL="1" columnsXL="1"
                      labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12"
                      layout="ResponsiveGridLayout"
                      maxContainerCols="1">

            <f:content>
                <Label required="true" text="{i18n>asint.cml.detail.renewCml.reasonForRenew.title}"/>
                <Input id="inpReasonRenew" value="{mCMLModel>/data/detailPage/resonForRenew}" change="onReasonRenewChange"/>

                <Label text="{i18n>asint.cml.detail.renewCml.selectedCml.title}"/>
                    <ScrollContainer width="100%" height="200px"
                    horizontal="true"
                    vertical="true">
                        <Table id="renewCMLTable"
                            inset="false"
                            items="{mCMLModel>/data/detailPage/renewCml}">

                            <columns>
                                <Column><Text text="{i18n>asint.cml.detail.renewCml.cmlName.title}"/></Column>
                                <Column><Text text="{i18n>asint.cml.detail.renewCml.cmlDesc.title}"/></Column>
                                <Column><Text text="{i18n>asint.cml.detail.renewCml.renewalDate.title}"/></Column>
                                <Column><Text text="{i18n>asint.cml.detail.renewCml.corrosionRate.title}"/></Column>
                                <Column><Text text="{i18n>asint.cml.detail.renewCml.thickness.title}"/></Column>
                                <Column><Text text="{i18n>asint.cml.detail.renewCml.minimumThickness.title}"/></Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <Text text="{mCMLModel>cmlName}" />
                                    <Text text="{mCMLModel>cmlDescription}" />
                                    <DatePicker value="{mCMLModel>renewalDate}"
                                                valueFormat="yyyy-MM-dd" change=".onFirstRowChange"/>
                                    <Select selectedKey="{mCMLModel>prevCorrRate}" forceSelection="false" change=".onFirstRowChange">
                                        <items>
                                            <core:Item key="YES" text="Yes"/>
                                            <core:Item key="NO" text="No"/>
                                        </items>
                                    </Select>
                                    <Input value="{mCMLModel>thickness}" type="Number" change=".onFirstRowChange"/>
                                    <Input value="{mCMLModel>minimumThickness}" type="Number" change=".onFirstRowChange"/>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </ScrollContainer>

                    <Label text=""/>
                    <CheckBox id="chkAdditional" text="{i18n>asint.cml.detail.renewCml.applyCheck.title}" select="onCheckBoxChange" selected="{mCMLModel>/data/detailPage/isCheckedCml}"/>  
            </f:content>
        </f:SimpleForm>

        <!-- Footer Buttons -->
        <buttons>
            <Button type="Emphasized" text="{i18n>asint.cml.detail.renewCml.renew.btn}" press=".onConfirmRenew"/>
            <Button type="Transparent" text="{i18n>asint.reusable.button.cancel.text}" press=".onCancelRenew"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
