<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">

    <Dialog title="{i18n>asint.cml.detail.page.overallReading.copy.dialog.title.text}"
            titleAlignment="Center"
            contentWidth="40%"
            draggable="true"
            afterOpen="fnSetTextAreaCount">

        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <f:content>

                    <Label text="{i18n>asint.cml.list.newCML.label.objectType}" />
                    <Select selectedKey="{mCMLModel>/data/detailPage/create/cml/objectType}">
                        <core:Item key="EQUI" text="{i18n>asint.reusable.object.equipment.text}" />
                        <core:Item key="FLOC" text="{i18n>asint.reusable.object.functionalLocation.text}" />
                    </Select>

                    <Label text="{i18n>asint.reusable.object.equipment.text}"
                           visible="{= ${mCMLModel>/data/detailPage/create/cml/objectType} === 'EQUI'}"/>
                    <Input visible="{= ${mCMLModel>/data/detailPage/create/cml/objectType} === 'EQUI'}"
                           type="Text"
                           value="{mCMLModel>/data/detailPage/create/cml/sObjectName}"
                           showValueHelp="true"
                           valueHelpOnly="true"
                           valueHelpRequest="fnHandleEquipmentValueHelpForCML"
                           placeholder="{i18n>asint.cml.list.newCML.placeholder.selectEquipment}" />

                    <Label text="{i18n>asint.reusable.object.functionalLocation.text}"
                           visible="{= ${mCMLModel>/data/detailPage/create/cml/objectType} === 'FLOC'}"/>
                    <Input visible="{= ${mCMLModel>/data/detailPage/create/cml/objectType} === 'FLOC'}"
                           type="Text"
                           value="{mCMLModel>/data/detailPage/create/cml/sObjectName}"
                           showValueHelp="true"
                           valueHelpOnly="true"
                           valueHelpRequest="fnHandleFunctionalLocationValueHelpForCML"
                           placeholder="{i18n>asint.cml.list.newCML.placeholder.selectFuntionalLocation}" />

                    <Label text="{i18n>asint.cml.list.newCML.label.objectTemplate}" visible="false"/>
                    <Select required="true"
                        visible="false"
                        items="{ path: 'mCMLModel>/data/detailPage/create/cml/objectTemplateList'}"
                        selectedKey="{mCMLModel>/data/detailPage/create/cml/selectedObjectTemplate}"
                        change="onObjectTemplateChange"
                        valueState="{mCMLModel>/metaData/detailPage/create/cml/valueState/objectTemplate}"
                        valueStateText="{mCMLModel>/metaData/detailPage/create/cml/valueStateText/objectTemplate}"
                        enabled="{mCMLModel>/metaData/detailPage/create/cml/enabled/objectTemplate}">
                        <core:Item key="{mCMLModel>ID}" text="{mCMLModel>to_description/0/shortDescription}" />
                    </Select>

                </f:content>
            </f:SimpleForm>
        </content>

        <buttons>
            <Button type="Emphasized" text="{i18n>asint.reusable.button.save.text}" press="onSaveCmlForNewAsset"/>
            <Button type="Transparent" text="{i18n>asint.reusable.button.cancel.text}" press="onCancelCmlForNewAsset"/>
        </buttons>

    </Dialog>

</core:FragmentDefinition>
