<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <Dialog title="{i18n>asint.cml.list.newInspection.dialog.title}" afterOpen="onAfterCreateInspectionDialogOpen" horizontalScrolling="false" contentWidth="50%" contentHeight="70%">
        <content>
            <Wizard id="idCreateInspectionWizard" renderMode="Page" showNextButton="false" navigationChange="onCreateInspectionWizNavChange">
                <steps>
                    <WizardStep title="{i18n>asint.cml.list.newInspection.dialog.wizard.step2.title}">
                        <content>
                            <f:SimpleForm editable="true" columnsM="1" columnsL="1" columnsXL="1" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" layout="ResponsiveGridLayout" maxContainerCols="1">
                                <f:content>
                                    <Label text="{i18n>asint.cml.list.newCML.label.objectType}"/>
                                    <Select selectedKey="{mCMLModel>/data/createInspectionWizard/objectType}" change="onCreateInspectionObjectTypeChange">
                                        <core:Item key="EQP" text="{i18n>asint.reusable.object.equipment.text}"/>
                                        <core:Item key="FLOC" text="{i18n>asint.reusable.object.functionalLocation.text}"/>
                                    </Select>
                                    <Label required="true" text="{i18n>asint.reusable.object.equipment.text}" visible="{= ${mCMLModel>/data/createInspectionWizard/objectType} === 'EQP' }"/>
                                    <Input type="Text" value="{mCMLModel>/data/createInspection/selectedObject/name}" placeholder="{i18n>asint.cml.list.newCML.placeholder.selectEquipment}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="fnHandleEquipmentValueHelpForInspection" visible="{= ${mCMLModel>/data/createInspectionWizard/objectType} === 'EQP' }"/>
                                    <Label required="true" text="{i18n>asint.reusable.object.functionalLocation.text}" visible="{= ${mCMLModel>/data/createInspectionWizard/objectType} === 'FLOC' }"/>
                                    <Input type="Text" value="{mCMLModel>/data/createInspection/selectedObject/name}" placeholder="{i18n>asint.cml.list.newCML.placeholder.selectFuntionalLocation}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="fnHandleFunctionalLocationValueHelpForInspection" visible="{= ${mCMLModel>/data/createInspectionWizard/objectType} === 'FLOC' }"/>
                                    <Label text="{i18n>asint.cml.list.newCML.label.objectTemplate}" />
                                    <MultiComboBox required="true" items="{ path: 'mCMLModel>/data/createInspection/objectTemplateList'}"
                                        selectedKeys="{mCMLModel>/data/listPage/create/cml/selectedObjectTemplate}"  selectionFinish="onCreateInspectionObjectTemplateChange" id="idDialogObjectTemplateInsp"
                                        valueState="{mCMLModel>/metaData/listPage/create/cml/valueState/objectTemplate}" valueStateText="{mCMLModel>/metaData/listPage/create/cml/valueStateText/objectTemplate}"
                                        enabled="{= ${mCMLModel>/data/createInspection/selectedObject/name}.length > 0 }">
                                    <core:ListItem key="{mCMLModel>ID}" text="{mCMLModel>to_description/0/shortDescription}"/>
                                    </MultiComboBox>
                                    <Label text="{i18n>asint.cml.list.newCML.label.inspectionTemplate}" />
                                    <ComboBox required="true" items="{ path: 'mCMLModel>/data/createInspection/inspectionTemplateList'}"
                                        selectedKey="{mCMLModel>/data/listPage/create/cml/selectedInspectionTemplate}"  change="onInspTemplateChange" id="idDialogInspectionTemplateInsp"
                                        valueState="{mCMLModel>/metaData/listPage/create/cml/valueState/inspectionTemplate}" valueStateText="{mCMLModel>/metaData/listPage/create/cml/valueStateText/inspectionTemplate}"
                                        enabled="{= ${mCMLModel>/data/createInspection/selectedObject/name}.length > 0 }" showSecondaryValues="true">
                                    <core:ListItem key="{mCMLModel>ID}" text="{mCMLModel>to_description/shortDescription}" additionalText="{mCMLModel>displayId}"/>
                                    </ComboBox>
                                </f:content>
                            </f:SimpleForm>
                            <!-- <HBox class="sapUiTinyMarginTopBottom" visible="{= ${mCMLModel>/data/createInspection/selectedObject/name} ? true : false }">
                                <items>
                                    <GenericTag class="sapUiTinyMarginBeginEnd" text="{mCMLModel>/data/createInspection/selectedObject/name}"/>
                                </items>
                            </HBox> -->
                            <!-- <SegmentedButton class="sapUiTinyMarginTopBottom" selectedKey="{mCMLModel>/data/createInspectionWizard/objectType}" selectionChange="onCreateInspectionObjectTypeChange" width="100%">
                                <items>
                                    <SegmentedButtonItem text="{i18n>asint.reusable.object.equipment.text}" key="EQP" />
                                    <SegmentedButtonItem text="{i18n>asint.reusable.object.functionalLocation.text}" key="FLOC" />
                                </items>
                            </SegmentedButton>
                            <Table id="idObjectTable" sticky="ColumnHeaders" mode="SingleSelectLeft" selectionChange="onCreateInspectionObjectSelection" items="{
                                    path: 'mCMLModel>/data/listPage/equipmentLocationList/tableList',
                                    filters: [{
                                        path: 'objectType', 
                                        operator: 'EQ',
                                        value1: 'EQP'
                                    }]
                                }">
                                <headerToolbar>
                                    <Toolbar>
                                        <SearchField value="{mCMLModel>/data/createInspectionWizard/objectSearchQuery}" search="onCreateInspectionObjectSearch" width="100%"/>
                                    </Toolbar>
                                </headerToolbar>
                                <columns>
                                    <Column>
                                        <Title text="{i18n>asint.cml.list.newInspection.dialog.wizard.object.table.column1.text}"/>
                                    </Column>
                                    <Column>
                                        <Title text="{i18n>asint.cml.list.newInspection.dialog.wizard.object.table.column1.text}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{mCMLModel>objectName}"/>
                                            <Text text="{mCMLModel>objectDesc}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table> -->
                        </content>
                    </WizardStep>
                    <WizardStep title="{i18n>asint.cml.list.newInspection.dialog.wizard.step1.title}">
                        <content>
                            <f:SimpleForm editable="true" columnsM="1" columnsL="1" columnsXL="1" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" layout="ResponsiveGridLayout" maxContainerCols="1">
                                <f:content>
                                    <Label required="true" text="{i18n>asint.cml.list.newInspection.dialog.inspection.description.text}"/>
                                    <Input value="{mCMLModel>/data/createInspection/inspectionDescription}" change="onValidateCreateInspectionWiz('step2')" />
                                    <Label required="true" text="{i18n>asint.cml.list.newInspection.dialog.inspection.date.text}"/>
                                    <DatePicker valueFormat="yyyy-MM-dd" value="{mCMLModel>/data/createInspection/inspectionDate}" change="onValidateCreateInspectionWiz('step2')" />
                                </f:content>
                            </f:SimpleForm>
                        </content>
                    </WizardStep>
                    <WizardStep title="{i18n>asint.cml.list.newInspection.dialog.wizard.step3.title}">
                        <content>
                            <HBox class="sapUiTinyMarginTopBottom" items="{
                                path: 'mCMLModel>/data/createInspection/selectedCml',
                                sorter : {
                                    path : 'cmlTemplate',
                                    group : true
                                }}" wrap="Wrap">
                                <items>
                                    <GenericTag class="sapUiTinyMarginBeginEnd" text="{mCMLModel>name} - {mCMLModel>desc}"/>
                                </items>
                            </HBox>
                            <Tree id="idStep3TreeTable" class="sapUiSmallMarginTop sapUiTinyMarginBottom" items="{path : 'mCMLModel>/data/createInspection/alteredcmlTemplate', parameters: {arrayNames:['nodes']}}" mode="MultiSelect" selectionChange="onCMLSelectionChange">
                                <items>
                                    <StandardTreeItem customData:type="{mCMLModel>type}" selected="{mCMLModel>selected}" title="{= ${mCMLModel>desc} &amp;&amp; ${mCMLModel>desc}.length > 0 ? ${mCMLModel>name}.concat(' - ', ${mCMLModel>desc}) : ${mCMLModel>name}}"/>
                                </items>
                            </Tree>
                        </content>
                    </WizardStep>
                    <WizardStep title="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.title}">
                        <content>
                            <Table id="idCMLReadingTable" sticky="HeaderToolbar,ColumnHeaders" items="{
                                path: 'mCMLModel>/data/createInspection/selectedCml',
                                sorter : {
                                    path : 'cmlTemplate',
                                    group : true,
                                    descending: false
                                }}">
                                <headerToolbar>
                                    <OverflowToolbar style="Clear">
                                        <ToolbarSpacer />
                                        <Button type="Transparent" class="asintRbiAddButton" text="Download Template" press="onDownloadCML"></Button>
                                        <MenuButton text="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.button.title}">
                                            <menu>
                                                <Menu>
                                                    <MenuItem text="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device1.button.title}"/>
                                                    <MenuItem text="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device2.button.title}"/>
                                                    <MenuItem text="{i18n>asint.cml.list.newInspection.dialog.wizard.step4.importFromDevice.device3.button.title}" press="OnImportFromFilePress">
                                                    </MenuItem>
                                                </Menu>
                                            </menu>
                                        </MenuButton>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column>
                                        <Title text="{i18n>asint.cml.list.newInspection.dialog.wizard.reading.table.column1.text}"/>
                                    </Column>
                                    <Column>
                                        <Title text="{i18n>asint.cml.list.newInspection.dialog.wizard.reading.table.column2.text} ({= ${mCMLModel>/data/UOM} === 'imperial' ? 'in' : 'mm'})"/>
                                    </Column>
                                     <Column>
                                        <Title text="{i18n>asint.cml.list.newInspection.dialog.wizard.reading.table.column3.text}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{mCMLModel>name} - {mCMLModel>desc}"/>
                                            <Input type="Number" width="180px" value="{mCMLModel>reading}" change="onValidateCreateInspectionWiz('step4')" />
                                            <DatePicker value="{mCMLModel>readingDate}" valueFormat="yyyy-MM-dd"  />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </WizardStep>
                </steps>
            </Wizard>
        </content>
        <buttons>
            <Button text="{i18n>asint.reusable.button.prev.text}" enabled="{= ${mCMLModel>/data/createInspectionWizard/currStep} &gt; 1}" press="onCreateInspectionWizNav($event,'prev')"/>
            <Button text="{i18n>asint.reusable.button.next.text}" enabled="{= ${mCMLModel>/data/createInspectionWizard/currStep} &lt; 4 &amp;&amp; ${mCMLModel>/data/createInspectionWizard/nextStepEnabled} }" press="onCreateInspectionWizNav($event,'next')"/>
            <Button type="Emphasized" visible="{= ${mCMLModel>/data/createInspectionWizard/currStep} === 4}" enabled="{mCMLModel>/data/createInspectionWizard/createEnabled}" text="{i18n>asint.reusable.button.create.text}" press="onCreateInspectionDialogCreate" />
            <Button text="{i18n>asint.reusable.button.cancel.text}" press="onCreateInspectionDialogCancel"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>