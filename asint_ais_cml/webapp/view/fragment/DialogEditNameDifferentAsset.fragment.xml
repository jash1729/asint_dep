<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">
    <Dialog title="{i18n>asint.cml.detail.page.overallReading.copy.dialog.title.text}" titleAlignment="Center" contentHeight="50%" contentWidth="50%" draggable="true" afterOpen="fnSetTextAreaCount">
    <Table id="idCustomDataSourceTable" items="{mCMLModel>/data/detailPage/copyPaste/diffAssetEdit/rowsData}" mode="None" sticky="ColumnHeaders,HeaderToolbar">
        <headerToolbar>
            <OverflowToolbar>
                <content>	
                    <Title text="{mCMLModel>/data/detailPage/copyPaste/diffAssetEdit/tableHeader}" level="H2"/>																
                    <ToolbarSpacer />
                </content>
            </OverflowToolbar>
        </headerToolbar>							
        <columns>
            <Column hAlign="Begin">
                <Text text="{i18n>asint.cml.detail.page.overallReading.copy.name.text}" />
            </Column>
            <Column hAlign="Begin" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                <Text text="{i18n>asint.cml.detail.page.overallReading.copy.description.text}" />
            </Column>
            <Column width="14%">
                <Text text="" />
            </Column>
        </columns>
        <items>
            <ColumnListItem vAlign="Top">
                <cells>
                    <Input value="{mCMLModel>cmlName}"/>
                    <TextArea width="100%" rows="3" showExceededText="true" maxLength="500" value="{mCMLModel>cmlDescription}"></TextArea>
                    <Button tooltip="Delete selected CML" class="sapUiSizeCompact" icon="sap-icon://delete" press="onDeleteCMLfromPaste"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
    <buttons>
        <Button type="Emphasized" text="{i18n>asint.reusable.button.save.text}" press="onSaveEditNameDifferentAsset"/>
        <Button type="Transparent" text="{i18n>asint.reusable.button.cancel.text}" press="onCancelEditNameDifferentAsset"/>
    </buttons>
    </Dialog>
</core:FragmentDefinition>