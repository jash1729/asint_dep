<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"> 
    <Dialog title="{i18n>asint.cml.list.newCML.dialog.title}" afterOpen="onAfterCreateCMLDialogOpen" horizontalScrolling="false" contentWidth="50%" contentHeight="50%">
        <content>
            <Wizard id="idCreateCMLWizard" renderMode="Page" showNextButton="false" navigationChange="onCreateCMLWizNavChange">
                <steps>
                    <WizardStep title="{i18n>asint.cml.list.newCML.dialog.wizard.step1.title}">
                        <content>
							<f:Form id="idFormContainerGeneral" editable="true" visible="true">
								<f:layout>
									<f:ResponsiveGridLayout
										labelSpanXL="12"
										labelSpanL="12"
										labelSpanM="12"
										labelSpanS="12"
										adjustLabelSpan="false"
										emptySpanXL="0"
										emptySpanL="0"
										emptySpanM="0"
										emptySpanS="0"
										columnsXL="1"
										columnsL="1"
										columnsM="1"
										singleContainerFullSize="false" />
								</f:layout>
								<f:formContainers>				
									<f:FormContainer>
										<f:formElements>
											<f:FormElement label="{i18n>asint.cml.list.newCML.label.objectType}">
												<f:fields>
													<Select selectedKey="{mCMLModel>/data/listPage/create/cml/objectType}" change="onCreateCMLObjectTypeChange">
														<core:Item key="EQUI" text="{i18n>asint.reusable.object.equipment.text}"/>
														<core:Item key="FLOC" text="{i18n>asint.reusable.object.functionalLocation.text}"/>
													</Select>
												</f:fields>
											</f:FormElement>
											<f:FormElement label="{i18n>asint.reusable.object.equipment.text}" visible="{= ${mCMLModel>/data/listPage/create/cml/objectType} === 'EQUI'}">
												<f:fields>
													<Input type="Text" value="{mCMLModel>/data/listPage/create/cml/sObjectName}" placeholder="{i18n>asint.cml.list.newCML.placeholder.selectEquipment}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="fnHandleEquipmentValueHelpForCML" visible="{= ${mCMLModel>/data/listPage/create/cml/objectType} === 'EQUI' }"/>
												</f:fields>
											</f:FormElement>
											<f:FormElement label="{i18n>asint.reusable.object.functionalLocation.text}" visible="{= ${mCMLModel>/data/listPage/create/cml/objectType} === 'FLOC'}">
												<f:fields>
													<Input type="Text" value="{mCMLModel>/data/listPage/create/cml/sObjectName}" placeholder="{i18n>asint.cml.list.newCML.placeholder.selectFuntionalLocation}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="fnHandleFunctionalLocationValueHelpForCML" visible="{= ${mCMLModel>/data/listPage/create/cml/objectType} === 'FLOC' }"/>
												</f:fields>
											</f:FormElement>
											<f:FormElement label="{i18n>asint.cml.list.newCML.label.objectTemplate}">
												<f:fields>
													<Select required="true" items="{ path: 'mCMLModel>/data/listPage/create/cml/objectTemplateList'}"
														selectedKey="{mCMLModel>/data/listPage/create/cml/selectedObjectTemplate}"  change="onObjectTemplateChange"
														valueState="{mCMLModel>/metaData/listPage/create/cml/valueState/objectTemplate}" valueStateText="{mCMLModel>/metaData/listPage/create/cml/valueStateText/objectTemplate}"
														enabled="{mCMLModel>/metaData/listPage/create/cml/enabled/objectTemplate}">
														<core:Item key="{mCMLModel>ID}" text="{mCMLModel>to_description/0/shortDescription}"/>
													</Select>
												</f:fields>
											</f:FormElement>																	
										</f:formElements>
									</f:FormContainer>
								</f:formContainers>
							</f:Form>
                        </content>
                    </WizardStep>
                    <WizardStep title="{i18n>asint.cml.list.newCML.dialog.wizard.step2.title}">
                        <content>
							<HBox class="sapUiMediumMarginTop sapUiTinyMarginBottom" alignItems="Center" wrap="Wrap">
								<Label text="{mCMLModel>/data/listPage/create/cml/objectType}:"></Label>
								<GenericTag class="sapUiTinyMarginBeginEnd" text="{mCMLModel>/data/listPage/create/cml/oSelectedObject/objectName}"/>
								<Label text="CML Template:"></Label>
								<GenericTag class="sapUiTinyMarginBeginEnd" text="{mCMLModel>/data/listPage/create/cml/selectedObjectTemplateName}"/>
							</HBox>
							<HBox justifyContent="Start" class="sapUiMediumMarginTop sapUiTinyMarginBottom">
								<RadioButtonGroup id="groupCML" columns="2" valueState="None" select="onChangeSelectCMLRadio">
									<RadioButton text="{i18n>asint.cml.list.newCML.dialog.wizard.step2.radiobtn.addCML.text}" class="sapUiMediumMarginEnd" selected="{mCMLModel>/data/listPage/create/cml/selectedCMLRadio}" />
									<RadioButton text="{i18n>asint.cml.list.newCML.dialog.wizard.step2.radiobtn.addGridCML.text}" class="sapUiMediumMarginBegin" selected="{mCMLModel>/data/listPage/create/cml/selectedGridCMLRadio}" />
								</RadioButtonGroup>
							</HBox>
							<VBox visible="{mCMLModel>/data/listPage/create/cml/selectedCMLRadio}">
								<f:Form id="idFormContainerTable" editable="true" visible="true" class="asintMetricsDataConfigureFormCls">
									<f:layout>
										<f:ResponsiveGridLayout
											labelSpanXL="12"
											labelSpanL="12"
											labelSpanM="12"
											labelSpanS="12"
											adjustLabelSpan="false"
											emptySpanXL="0"
											emptySpanL="0"
											emptySpanM="0"
											emptySpanS="0"
											columnsXL="1"
											columnsL="1"
											columnsM="1"
											singleContainerFullSize="false" />
									</f:layout>
									<f:formContainers>				
										<f:FormContainer>
											<f:formElements>
												<f:FormElement>
													<f:fields>
														<Table id="idCustomDataSourceTable" items="{mCMLModel>/data/listPage/create/cml/customDataset}" mode="None" sticky="ColumnHeaders,HeaderToolbar">
															<headerToolbar>
																<OverflowToolbar>
																	<content>																	
																		<ToolbarSpacer />
																		<Input id="idCreateCMLRows" type="Number" placeholder="Enter number of CMLs" change="onTableNumberValChange" width="50%" valueState="{mCMLModel>numbersValueState}"/>																																	
																		<Button tooltip="Add new CML" class="sapUiSizeCompact" enabled="{mCMLModel>/metaData/listPage/create/cml/enabled/addIcon}" icon="sap-icon://add" press="handleAddNewRow"/>
																	</content>
																</OverflowToolbar>
															</headerToolbar>							
															<columns>
																<Column hAlign="Begin">
																	<Text text="Name" />
																</Column>
																<Column hAlign="Begin" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
																	<Text text="Description" />
																</Column>
																<Column hAlign="Begin" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
																	<Text text="CML Template" />
																</Column>
																<Column hAlign="End">
																	<Text text="" />
																</Column>
															</columns>
															<items>
																<ColumnListItem vAlign="Middle">
																	<cells>
																		<Input value="{mCMLModel>name}" change="onTableNameValChange($event, 'addCML')" valueState="{mCMLModel>nameValueState}" valueStateText="{mCMLModel>nameValueStateText}" enabled="{mCMLModel>/metaData/listPage/create/cml/enabled/name}"/>
																		<Input value="{mCMLModel>description}" change="onTableDescpValChange($event, 'addCML')" valueState="{mCMLModel>descpValueState}" enabled="{mCMLModel>/metaData/listPage/create/cml/enabled/description}"></Input>
																		<Select required="true" items="{ path: 'mCMLModel>/data/listPage/locationList/locationTemplateList', templateShareable: true}"
																			selectedKey="{mCMLModel>cmlTemplate}"  change="onCMLTemplateChange($event, 'addCML')"
																			valueState="{mCMLModel>/metaData/listPage/create/cml/valueState/cmlTemplate}" valueStateText="{mCMLModel>/metaData/listPage/create/cml/valueStateText/cmlTemplate}"
																			enabled="{mCMLModel>/metaData/listPage/create/cml/enabled/cmlTemplate}">
																			<core:Item key="{mCMLModel>id}" text="{mCMLModel>name}"/>
																		</Select>
																		<Button tooltip="Delete selected CML" class="sapUiSizeCompact" icon="sap-icon://delete" enabled="{mCMLModel>/data/listPage/create/cml/isDeleteEnabled}" press="handleDeleteTableRow"/>
																	</cells>
																</ColumnListItem>
															</items>
														</Table>
													</f:fields>
												</f:FormElement>
											</f:formElements>
										</f:FormContainer>
									</f:formContainers>
								</f:Form>
							</VBox>
							<VBox visible="{mCMLModel>/data/listPage/create/cml/selectedGridCMLRadio}">
								<f:SimpleForm id="idFormGridCMLContainer" editable="true">
									<f:content>
										<Label id="idForGridCMLName" required="true"
											text="{i18n>asint.cml.list.newGridCML.dialog.gridCMLName.text}" />
										<Input required="true"
											value="{mCMLModel>/data/listPage/create/cml/customGridDataset/gridCMLName}"
											id="idForGridCMLInput" />

										<Label id="idForGridCMLRows" required="true"
											text="{i18n>asint.cml.list.newGridCML.dialog.gridCMLRows.text}" />
										<StepInput required="true" id="idForGridCMLRowsInput" change="onChangeStepInput" textAlign="Center"
											value="{mCMLModel>/data/listPage/create/cml/customGridDataset/rowSize}"
											class="sapUiSizeCompact" min="2"
											max="50" width="100%" />

										<Label id="idForGridCMLColumn" required="true"
											text="{i18n>asint.cml.list.newGridCML.dialog.gridCMLColumns.text}" />
										<StepInput required="true" id="idForGridCMLColumnsInput" change="onChangeStepInput" textAlign="Center"
											value="{mCMLModel>/data/listPage/create/cml/customGridDataset/colSize}"
											class="sapUiSizeCompact" min="2"
											max="50" width="100%" />

										<Label id="idForCMLTemplate" required="true"
											text="{i18n>asint.cml.list.newCML.label.cmlTemplate}" />
										<Select required="true" id="idForCMLTemplateInput"
											items="{ path: 'mCMLModel>/data/listPage/locationList/locationTemplateList', templateShareable: true}"
											selectedKey="{mCMLModel>/data/listPage/create/cml/customGridDataset/cmlTemplate}"
											change="onCMLTemplateChange($event,'addGridCML')"
											valueState="{mCMLModel>/metaData/listPage/create/cml/valueState/cmlTemplate}"
											valueStateText="{mCMLModel>/metaData/listPage/create/cml/valueStateText/cmlTemplate}"
											enabled="{mCMLModel>/metaData/listPage/create/cml/enabled/cmlTemplate}">
											<core:Item key="{mCMLModel>id}" text="{mCMLModel>name}" />
										</Select>
									</f:content>
								</f:SimpleForm>
							</VBox>
                        </content>
                    </WizardStep>
					<WizardStep visible="{mCMLModel>/data/listPage/create/cml/selectedGridCMLRadio}" title="{i18n>asint.cml.list.newCML.dialog.wizard.step3.title}">
                        <content>
							<HBox class="sapUiMediumMarginTop sapUiTinyMarginBottom" alignItems="Center" wrap="Wrap">
								<Label text="Grid CML Name:"></Label>
								<GenericTag class="sapUiTinyMarginBeginEnd" text="{mCMLModel>/data/listPage/create/cml/customGridDataset/gridCMLName}"/>
								<Label text="Grid (Rows x Columns):"></Label>
								<GenericTag class="sapUiTinyMarginBeginEnd" text="{mCMLModel>/data/listPage/create/cml/customGridDataset/rowSize} x {mCMLModel>/data/listPage/create/cml/customGridDataset/colSize}"/>
							</HBox>
							<f:Form id="idFormGridCMLContainerTable" editable="true" visible="true" class="asintMetricsDataConfigureFormCls">
								<f:layout>
									<f:ResponsiveGridLayout
										labelSpanXL="12"
										labelSpanL="12"
										labelSpanM="12"
										labelSpanS="12"
										adjustLabelSpan="false"
										emptySpanXL="0"
										emptySpanL="0"
										emptySpanM="0"
										emptySpanS="0"
										columnsXL="1"
										columnsL="1"
										columnsM="1"
										singleContainerFullSize="false" />
								</f:layout>
								<f:formContainers>				
									<f:FormContainer>
										<f:formElements>
											<f:FormElement>
												<f:fields>
													<Table id="idCustomGridCMLDataSourceTable" items="{mCMLModel>/data/listPage/create/cml/customRowColumDataSet}" mode="None" sticky="ColumnHeaders,HeaderToolbar">
														<columns>
															<Column hAlign="Begin">
																<Text text="{i18n>asint.cml.list.newCML.name.label.text}" />
															</Column>
															<Column hAlign="Begin" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
																<Text text="{i18n>asint.cml.list.newCML.description.label.text}" />
															</Column>
														</columns>
														<items>
															<ColumnListItem vAlign="Middle">
																<cells>
																	<Input value="{mCMLModel>name}" change="onTableNameValChange($event, 'addGridCML')" valueState="{mCMLModel>nameValueState}" valueStateText="{mCMLModel>nameValueStateText}"/>
																	<Input value="{mCMLModel>description}" change="onTableDescpValChange($event, 'addGridCML')" valueState="{mCMLModel>descpValueState}" />
																</cells>
															</ColumnListItem>
														</items>
													</Table>
												</f:fields>
											</f:FormElement>
										</f:formElements>
									</f:FormContainer>
								</f:formContainers>
							</f:Form>
                        </content>
                    </WizardStep>
                </steps>
            </Wizard>
        </content>
        <buttons>
            <Button text="{i18n>asint.reusable.button.prev.text}" enabled="{= ${mCMLModel>/metaData/listPage/create/cml/wizard/currStep} &gt; 1}" press="onCreateCMLWizNav($event,'prev')"/>
            <Button text="{i18n>asint.reusable.button.next.text}" enabled="{= ${mCMLModel>/metaData/listPage/create/cml/wizard/currStep} &lt; 3 &amp;&amp; ${mCMLModel>/metaData/listPage/create/cml/wizard/nextStepEnabled} }" press="onCreateCMLWizNav($event,'next')"/>
            <Button type="Emphasized" 
				visible="{= (${mCMLModel>/metaData/listPage/create/cml/wizard/currStep} === 2 &amp;&amp; ${mCMLModel>/data/listPage/create/cml/selectedCMLRadio}) 
					|| (${mCMLModel>/metaData/listPage/create/cml/wizard/currStep} === 3 &amp;&amp; ${mCMLModel>/data/listPage/create/cml/selectedGridCMLRadio}) }" 
				enabled="{mCMLModel>/metaData/listPage/create/cml/wizard/createEnabled}" 
				text="{i18n>asint.reusable.button.create.text}" 
				press="onCMLCreate" />
            <Button text="{i18n>asint.reusable.button.cancel.text}" press="onCMLDialogClose"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>