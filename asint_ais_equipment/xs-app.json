{
  "welcomeFile": "/webapp/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/resources/com/asint/ais/library/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "localDir": "../asint_ais_library/src/com/asint/ais/library"
    },
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/webapp/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "localDir": "webapp"
    },
    {
      "source": "^/asint/event_layer/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "asint_ais_event_layer-api"
    },
    {
      "source": "^/asint/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "asint-ais-backend-api"
    },
    {
      "source": "^/workflow_api/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "AIS_WORKFLOW"
    },
    {
      "source": "^/bpa_api/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "AIS_BPA"
    },
    {
      "source": "^/apm_recommendation_api/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "AIS_APM_RECOMMENDATION"
    },
    {
      "source": "^/apm_risk_criticality_assessment_service_api/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "AIS_APM_RISK_CRITICALITY_ASSESSMENT"
    },
    {
      "source": "^/feature_flag/(.*)$",
      "target": "$1",
      "csrfProtection": false,
      "authenticationType": "xsuaa",
      "destination": "asint-ais-feature_flag"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
