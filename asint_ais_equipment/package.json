{
    "name": "equipment",
    "version": "0.1.5",
    "private": true,
    "description": "Equipment",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "devDependencies": {
        "@ui5/cli": "^4.0.0",
        "@sap/ux-ui5-tooling": "1.16.2",
        "@sap/ui5-builder-webide-extension": "^1.1.9",
        "ui5-task-zipper": "^3.3.1",
        "mbt": "^1.2.29",
        "@sap/approuter": "10.9.2",
        "@ui5/middleware-code-coverage": "^2.0.3",
        "http-server": "^14.1.1",
        "@wdio/cli": "^9.23.2",
        "@wdio/local-runner": "^9.23.2",
        "@wdio/mocha-framework": "^9.23.2",
        "@wdio/spec-reporter": "^9.23.2",
        "chromedriver": "^132.0.0",
        "tree-kill": "^1.2.2",
        "wdio-qunit-service": "^2.0.1"
    },
    "scripts": {
        "start": "fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#comasintaismiequipment-manage\"",
        "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#comasintaismiequipment-manage\"",
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
        "deploy": "fiori verify",
        "deploy-config": "fiori add deploy-config",
        "start-noflp": "fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
        "start-variants-management": "fiori run --open \"preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",
        "unit-tests": "fiori run --open 'test/unit/unitTests.qunit.html'",
        "unit-tests-with-coverage": "fiori run --open \"test/unit/unitTests.qunit.html?coverage\"",
        "unit-tests-headless": "node webapp/test/wdioTestRunner.js",
        "int-tests": "fiori run --open 'test/integration/opaTests.qunit.html'",
        "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
        "locally": "node local-approuter.js"
    },
    "ui5": {
        "dependencies": [
            "@sap/ux-ui5-tooling",
            "@sap/ui5-builder-webide-extension",
            "ui5-task-zipper",
            "mbt",
            "@ui5/middleware-code-coverage"
        ]
    },
    "sapuxLayer": "CUSTOMER_BASE"
}
