<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="{i18n>asint.equipment.detail.changeHeader.dialog.title}">
        <VBox class="sapUiSmallMargin">
            <f:SimpleForm
                id="idEditHeaderDetail"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            >
                <f:content>
                    <Label text="{i18n>asint.equipment.field.name.label}" />
                    <Input value="{mEquipmentDetail>/data/dialog/editHeader/name}" />
                    <Label text="{i18n>asint.equipment.detail.header.description.label}" />
                    <Input value="{mEquipmentDetail>/data/dialog/editHeader/to_description/0/shortDescription}" />
                    <Label text="{i18n>asint.equipment.field.category.label}" />
                    <Input  value="{mEquipmentDetail>/data/dialog/editHeader/category}" valueHelpOnly="true" showValueHelp="true" showClearIcon="true" valueHelpRequest="openValueHelp($event ,'EQUI', 'SingleSelectLeft')" />
                    <!-- <ComboBox id="" items="{ path: 'mEquipment>/data/equipmentCategoryArray'}"
                        selectedKey="{mEquipmentDetail>/data/dialog/editHeader/category}" showSecondaryValues = "true"
                        editable="true" >
                        <core:ListItem key="{mEquipment>category}" text="{mEquipment>categoryDesc}" additionalText="{mEquipment>category}"/>
                    </ComboBox> -->
                    <Label text="{i18n>asint.equipment.field.validityStartDate.label}" />
                    <DatePicker id="" value="{mEquipmentDetail>/data/dialog/editHeader/validityStartDateTime}"
						change="onNotificationFormChange" valueFormat="yyyy-MM-dd" displayFormat="MMM dd, yyyy" class="asintAssetStrategyTargetDate" />
                    <Label text="{i18n>asint.equipment.field.validityEndDateTime.label}" />
                    <DatePicker id="" value="{mEquipmentDetail>/data/dialog/editHeader/validityEndDateTime}"
						change="onNotificationFormChange" valueFormat="yyyy-MM-dd" displayFormat="MMM dd, yyyy" class="asintAssetStrategyTargetDate" />
                    <Label text="{i18n>asint.equipment.field.flagComponent.label}" />
                    <ComboBox items="{ path: 'mEquipmentDetail>/metadata/dropDown/componentFlag'}"
                        selectedKey="{mEquipmentDetail>/data/dialog/editHeader/flagComponent}">
                        <core:ListItem key="{mEquipmentDetail>key}" text="{mEquipmentDetail>text}"/>
                    </ComboBox>
                </f:content>
            </f:SimpleForm>
        </VBox>
        <buttons>
            <Button text="{i18n>asint.reusable.button.save.text}" press="onSave($event,'header')" />
            <Button text="{i18n>asint.reusable.button.cancel.text}" press="onEdit($event,'headerCancel')" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
