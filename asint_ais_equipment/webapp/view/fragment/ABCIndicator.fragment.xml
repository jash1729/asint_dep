<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        title="{i18n>asint.equipment.detail.valuehelp.indicator.title}"
        class="asintAddRemoveTempDialogWidth"
        contentWidth="30rem" contentHeight="auto">
        <Table id="idAbcIndicator" visible="true" growing="true" growingScrollToLoad="true" growingThreshold="20" mode="SingleSelectMaster" noDataText="" popinLayout="GridLarge" alternateRowColors="true" 
        items="{path:'masterS4Service>/ABCIndicator'}" selectionChange="onSelectABC" sticky="ColumnHeaders,HeaderToolbar">
            <columns>
                <Column width="10rem">
                    <Text text="{i18n>asint.equipment.detail.valuehelp.indicator}"/>
                </Column>
                <Column>
                    <Text text="{i18n>asint.equipment.detail.valuehelp.indicatorDesc}"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{masterS4Service>indicator}"/>
                        <Text text="{masterS4Service>indicatorDesc}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
         <buttons>
                <Button text="{i18n>asint.reusable.close.button}" press="onCloseIndicator"/>
           </buttons>
 </Dialog>
</core:FragmentDefinition>