<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="{i18n>asint.equipment.advancedFilters.create.classValueHelp.text}" contentHeight="70%" contentWidth="60%">
        <Table growing="true" growingScrollToLoad="true" growingThreshold="20" id="idClassValueHelp" mode="MultiSelect" noDataText="{i18n>asint.reusable.noData.text}" items="{
            path: 'masterService>/ClassValueHelp',
            sorter: { path: 'displayId', descending: true },  parameters: { countMode: 'Inline' },
            events: {dataReceived: '.onDataClassessAdvancedFilterReceived' }
            }" selectionChange="onSelectClassesForAssign">
            <headerToolbar>
                <OverflowToolbar design="Transparent">
                    <Title text="{mEquipmentList>/data/AdvancedFilters/S4Classes/tableHeader}" level="H2" />
                    <ToolbarSpacer />
                    <SearchField id="idAdvFilters4ValueHelpSearchField" placeholder="{i18n>asint.equipment.tab.classes.search.tooltip.text}" width="30%" liveChange="onSearchClassesAssignDialogForS4"/>
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column popinDisplay="Inline" vAlign="Middle">
                    <Text text="{i18n>asint.equipment.tab.classes.class.label}" />
                </Column>
                <Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Top">
                    <Text text="{i18n>asint.equipment.tab.classes.classDesc.label}" />
                </Column>
                <Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Middle">
                    <Text text="{i18n>asint.equipment.tab.classes.externalSystem.label}" />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <ObjectIdentifier title="{masterService>displayId}"/>
                        <Text text="{masterService>shortDescription}" wrapping="true" wrappingType="Normal" />
                        <Text text="S4HPC"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <buttons>
            <Button text="{i18n>asint.reusable.button.ok.text}" enabled="{mEquipmentList>/data/AdvancedFilters/Classes/isOkEnabled}" press="onConfirmClassSelection" />
            <Button text="{i18n>asint.reusable.button.cancel.text}" press="onCloseClassValueHelp" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>