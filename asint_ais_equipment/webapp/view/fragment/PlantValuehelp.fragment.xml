<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        title="{i18n>asint.equipment.detail.valuehelp.plant.title}"
        class="asintAddRemoveTempDialogWidth"
        contentWidth="30rem" contentHeight="auto">
        <Table id="idObjectPlant" visible="true" growing="true" growingScrollToLoad="true" growingThreshold="20" mode="SingleSelectMaster" noDataText="" popinLayout="GridLarge" alternateRowColors="true" 
        items="{path:'masterS4Service>/PlantList'}" selectionChange="onSelectPlant" sticky="ColumnHeaders,HeaderToolbar">
            <columns>
                <Column width="10rem">
                    <Text text="{i18n>asint.equipment.detail.valuehelp.plant}"/>
                </Column>
                <Column>
                    <Text text="{i18n>asint.equipment.detail.valuehelp.plantName}"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{masterS4Service>plant}"/>
                        <Text text="{masterS4Service>plantName}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <buttons>
            <Button text="{i18n>asint.reusable.close.button}" press="onClosePlant"/>
        </buttons>
 </Dialog>
</core:FragmentDefinition>