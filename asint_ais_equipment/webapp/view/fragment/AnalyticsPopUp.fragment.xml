<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">
    <Dialog showHeader="false" contentWidth="30%" draggable="true">
        <Table sticky="ColumnHeaders,HeaderToolbar" items="{path: 'mEquipmentList>/data/analytics/popupData'}" growing="true" growingThreshold="10"
            noDataText="{i18n>asint.equipment.detail.templates.dialog.table.noData.text}">
            <headerToolbar>
                <OverflowToolbar design="Transparent">
                    <Title text="{mEquipmentList>/data/analytics/popupDataHeader}"/>
                    <ToolbarSpacer/>
                    <SearchField width="30%" placeholder="Search by name or description" class="sapUiTinyMarginEnd" liveChange="fnSearchEqui"/>
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column hAlign="Begin">
                    <Text text="{i18n>asint.equipment.list.analytics.vizpopover.fragent.name.title}"/>
                </Column>
                <Column hAlign="Begin" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                    <Text text="{i18n>asint.equipment.list.analytics.vizpopover.fragent.desc.title}"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{mEquipmentList>objectName}"/>
                        <Text text="{mEquipmentList>objectDescription}"></Text>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <buttons>
            <Button type="Transparent" text="{i18n>asint.reusable.close.button}" press="onAnalyticsPopupClose"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>