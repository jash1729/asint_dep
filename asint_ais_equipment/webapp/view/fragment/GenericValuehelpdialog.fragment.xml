<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog  title="Value Help" id="valueHelpDialog" class="asintAddRemoveTempDialogWidth"
        contentWidth="30rem" contentHeight="auto">
        <VBox>
        <Toolbar>
            <ToolbarSpacer />
            <SearchField  placeholder="Search by Name or Description" id="idGenericSearchField" search="onValueHelpSearch" width="50%" />
        </Toolbar>
        <Table id="valueHelpTable" growing="true" growingScrollToLoad="true" alternateRowColors="true" growingThreshold="20"  
            selectionChange="onSelectValue" sticky="ColumnHeaders,HeaderToolbar" items="{path: 'valueHelpService>/S4Master', sorter: {path: 'name', descending: false}}"  updateFinished="onUpdateFinish">
            <columns>
                <Column>
                    <Text text="{i18n>asint.reusable.name.text}"/>
                </Column>
                <Column>
                    <Text text="{i18n>asint.reusable.description.text}"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{valueHelpService>name}"/>
                        <Text text="{valueHelpService>description}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
    <buttons>
    <Button text="{i18n>asint.reusable.button.save.text}" press="onCloseValueHelpDialog"/>
    <Button text="{i18n>asint.reusable.button.cancel.text}" press="onCloseGenericDialog"/>
    </buttons>            
    </Dialog>
</core:FragmentDefinition>
