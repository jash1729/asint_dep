<mvc:View xmlns:core="sap.ui.core"
	controllerName="com.asint.ais.mi.equipment.controller.detail.Assignments"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<l:VerticalLayout>
		<l:content>
			<Table id="idTableObjectTemplate" growing="true" growingScrollToLoad="false"
				growingThreshold="5" mode="MultiSelect"
				noDataText="No Data" popinLayout="GridLarge" alternateRowColors="true"
				items="{path: 'mEquipmentDetail>/data/assignments/objectTemplate/templateList'}"
				selectionChange="onObjectTemplateSelect">
				<headerToolbar>
					<OverflowToolbar design="Transparent">
						<Title
							text="{mEquipmentDetail>/data/assignments/objectTemplate/templateHeaderCount}"
							level="H2" />
						<ToolbarSpacer />
						<SearchField placeholder="{i18n>asint.equipment.tab.assignments.objectTemplate.search.placeholder.text}" tooltip="{i18n>asint.equipment.tab.assignments.objectTemplate.search.tooltip.text}" width="30%" liveChange="onSearchEquipmentTemplate"/>
						<Button type="Emphasized" text="{i18n>asint.reusable.button.assign.text}"
							enabled="{mEquipmentDetail>/metadata/enabled/assign}"
							visible="{=${mEquipmentDetail>/metadata/status/isUnpublished} &amp;&amp; ${mEquipmentDetail>/data/userRoles/edit} }"
							press="onAssignEquipmentTemplate" />
						<Button text="{i18n>asint.reusable.button.unassign.text}"
							enabled="{mEquipmentDetail>/metadata/enabled/unassign}"
							visible="{=${mEquipmentDetail>/metadata/status/isUnpublished} &amp;&amp; ${mEquipmentDetail>/data/userRoles/edit} }"
							press="onRemoveTemplate" />
						<Button icon="sap-icon://sort"
							tooltip="{i18n>asint.equipment.tab.sort.text}"
							press="onSortEquipmentTemplate" />
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column popinDisplay="Inline" vAlign="Middle">
						<Text
							text="{i18n>asint.equipment.tab.objectTemplate.resuable.table.template}" />
					</Column>
					<!-- <Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet"
						vAlign="Top">
						<Text text="{i18n>asint.equipment.tab.objectTemplate.resuable.table.status}" />
					</Column> -->
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet"
						vAlign="Middle">
						<Text text="{i18n>asint.equipment.tab.objectTemplate.resuable.table.type}" />
					</Column>
					<!-- <Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet"
						vAlign="Middle">
						<Text
							text="{i18n>asint.equipment.tab.objectTemplate.resuable.table.comment}" />
					</Column> -->
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectIdentifier title="{mEquipmentDetail>displayId}"
								text="{mEquipmentDetail>name}"
								titleActive="false"
								titlePress="onClickIDMSInspection" />
							<!-- <Text text="{mEquipmentDetail>templateTypeText}" wrapping="true"
								wrappingType="Normal" /> -->
							<Text text="Equipment Template" />
							<!-- <Text text="" /> -->
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</l:content>
	</l:VerticalLayout>
</mvc:View>