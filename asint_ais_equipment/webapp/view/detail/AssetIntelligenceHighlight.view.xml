	<Panel id="idAsintStatusPanel5" visible="{= ${mEquipment>/metadata/featureFlag/showAssetIntelligenceHighlight} === '1'}">
		<f:GridContainer id="grd" inlineBlockLayout="true">
			<!-- First Card -->
			<f:Card class="sapUiSmallMarginTop" width="350px" height="200px">
				<f:header>
					<card:Header
						title="{i18n>asint.equipment.detail.tab.assetIntelligence.highLight.card.rca.title}"
						subtitle="{mEquipmentDetail>/data/assetIntelligence/highlights/sRCAFormatedCardSubTitle}" />
				</f:header>
				<f:layoutData>
					<f:GridContainerItemLayoutData columns="4" />
				</f:layoutData>
				<f:content>
					<VBox justifyContent="Center">
						<HBox height="35px" alignItems="Start">
							<Label class="sapUiSmallMarginBegin"
								text="{i18n>asint.equipment.detail.tab.assetIntelligence.highLight.card.rca.highRiskScore}:" />
							<HBox class="sapUiTinyMarginBegin" alignItems="Start">
								<ObjectStatus
									text=""
									icon="sap-icon://circle-task-2"
									state="{mEquipmentDetail>/data/assetIntelligence/highlights/state}"
									visible="{= ${mEquipmentDetail>/data/assetIntelligence/highlights/state} !== 'None'}" />
								<VBox>
									<Text
										text="{mEquipmentDetail>/data/assetIntelligence/highlights/highestRiskScore}" />
								</VBox>
							</HBox>
						</HBox>

						<HBox height="25px" alignItems="Center">
							<Label class="sapUiSmallMarginBegin sapUiTinyMarginTop"
								text="{i18n>asint.equipment.detail.tab.assetIntelligence.highLight.card.rca.criticality}:" />
							<ObjectStatus class="sapUiTinyMarginBegin sapUiTinyMarginTop"
								text="{mEquipmentDetail>/data/assetIntelligence/highlights/criticalityCode} ({mEquipmentDetail>/data/assetIntelligence/highlights/criticalityText})"
								icon=""
								state="{mEquipmentDetail>/data/assetIntelligence/highlights/state}"
								visible="{= ${mEquipmentDetail>/data/assetIntelligence/highlights/state} !== 'None'}" />
						</HBox>
					</VBox>
				</f:content>
			</f:Card>

