<mvc:View xmlns:mvc="sap.ui.core.mvc" controllerName="com.asint.ais.mi.equipment.controller.detail.Groups"
	xmlns:f="sap.ui.layout.form"
	xmlns:table="sap.ui.table"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core" core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	xmlns="sap.m">
	<l:VerticalLayout>
		<l:content>
			<Table id="idTableGroups" growing="true" growingScrollToLoad="true" growingThreshold="5" noDataText="{i18n>asint.reusable.noData.text}" popinLayout="GridLarge" alternateRowColors="true" items="{path:'mEquipmentDetail>/data/tabs/components/groups/groupsList'}">
				<headerToolbar>
					<OverflowToolbar design="Transparent">
						<Title level="H2" text="{
							parts: [        
								'i18n>asint.equipment.tab.groups.toolbar.title',
								'mEquipmentDetail>/data/tabs/components/groups/groupsLength'
							],
							formatter: 'formatMessage'
						}"/>
						<ToolbarSpacer />
						<SearchField id="idEquipmentGroupsSearchField" width="20%" placeholder="{i18n>asint.reusable.search.text}" liveChange="onSearchGroupsTable" search="onSearchGroupsTable"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column popinDisplay="Inline">
						<Text text="{i18n>asint.equipment.tab.groups.table.column.group.text}" />
					</Column>
					<Column demandPopin="true" popinDisplay="Inline">
						<Text text="{i18n>asint.equipment.tab.groups.table.column.description.text}" />
					</Column>
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet">
						<Text text="{i18n>asint.equipment.tab.groups.table.column.template.text}" />
					</Column>
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet">
						<Text text="{i18n>asint.equipment.tab.groups.table.column.type.text}" />
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectIdentifier text="{mEquipmentDetail>streamName}" title="{mEquipmentDetail>displayId}" titleActive="true" titlePress="onPressLink($event,'GROUPS')"/>
							<Text text="{mEquipmentDetail>shortDescription}"/>
							<ObjectIdentifier text="{mEquipmentDetail>templateShortDescription}" title="{mEquipmentDetail>templateDisplayId}" titleActive="true" titlePress="onPressLink($event,'ASSESSMENT_TEMPLATE')"/>
                            <Text text="{mEquipmentDetail>categoryType}"/>						
                        </cells>
					</ColumnListItem>
				</items>
			</Table>
		</l:content>
	</l:VerticalLayout>
</mvc:View>
