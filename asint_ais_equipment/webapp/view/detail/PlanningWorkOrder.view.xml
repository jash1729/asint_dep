	<l:VerticalLayout>
		<l:content>
			<Table id="idTableWOSegment" growing="true" growingScrollToLoad="false" growingThreshold="5" mode="None"
				noDataText="No Data" popinLayout="GridLarge" alternateRowColors="true"
				items="{path: 'mEquipmentDetail>/data/tabs/planning/workOrder'}">
				<headerToolbar>
					<OverflowToolbar design="Transparent">
						<SegmentedButton id="idWOSegment" selectionChange="onSelectWOSegment" selectedKey="all">
							<items>
									<SegmentedButtonItem text="All" key="all"/>
									<SegmentedButtonItem icon="sap-icon://fob-watch" text="Pending" key="pending"/>
									<SegmentedButtonItem icon="sap-icon://future" text="Planned" key="planned"/>
									<SegmentedButtonItem icon="sap-icon://complete" text="Completed" key="completed"/>
								</items>
						</SegmentedButton>
						<ToolbarSpacer/>
						<SearchField id="idWOSearch" liveChange="onHandlePlanningWOsearch" 
							placeholder="{i18n>asint.equipment.tab.planned.resuable.table.searchWO.text}" search="onHandlePlanningWOsearch" width="20%"></SearchField>
						<Button icon="sap-icon://action-settings" tooltip="{i18n>asint.equipment.list.tooltip.settings}" press="onPressWOTableSettings" />
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column popinDisplay="Inline" vAlign="Top">
						<Text customData:tableSettings="workOrderName" customData:tableSettingsEnable="false" text="{i18n>asint.equipment.tab.planned.resuable.table.workOrder.text}"/>
					</Column>
					<Column visible="false" popinDisplay="Inline" vAlign="Top">
						<Text customData:tableSettings="workOrderDescp" customData:tableSettingsEnable="false" text="{i18n>asint.equipment.tab.planned.resuable.table.workOrder.text}"/>
					</Column>
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Top">
						<Text customData:tableSettings="workOrderType" text="{i18n>asint.equipment.tab.planned.resuable.table.type.text}"/>
					</Column>
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Top">
						<Text customData:tableSettings="workOrderPriority" text="{i18n>asint.equipment.tab.planned.resuable.table.priority.text}"/>
					</Column>
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Top">
						<Text customData:tableSettings="workOrderProgress" customData:tableSettingsEnable="false" text="{i18n>asint.equipment.tab.planned.resuable.table.progress.text}"/>
					</Column>
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Top">
						<Text customData:tableSettings="workOrderStatus" text="{i18n>asint.equipment.tab.planned.resuable.table.status.text}"/>
					</Column>
					<Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Top">
						<Text customData:tableSettingsEnable="false" text="{i18n>asint.equipment.tab.planned.resuable.table.startEndDate.text}"/>
					</Column>
					<Column visible="false">
						<Text customData:tableSettings="StartDate" text="{i18n>asint.equipment.tab.planned.resuable.table.StartDate.text}"/>
					</Column>
					<Column visible="false">
						<Text customData:tableSettings="EndDate" text="{i18n>asint.equipment.tab.planned.resuable.table.EndDate.text}"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectIdentifier title="{mEquipmentDetail>workOrderName}" text="{mEquipmentDetail>workOrderDescp}" titleActive="true" titlePress="onClickWOTitle"/>
							<Text visible="false" text="{mEquipmentDetail>workOrderDescp}"/>
							<Text text="{mEquipmentDetail>workOrderType}" wrapping="true" wrappingType="Normal"/>
							<HBox>
								<core:Icon class="iotAinCustomTitleColor sapUiTinyMarginEnd" color="{= ${mEquipmentDetail>workOrderPriority} === 'High' ? '#BB0000' : ${mEquipmentDetail>workOrderPriority} === 'Very High' ? '#BB0000' : ${mEquipmentDetail>workOrderPriority} === 'Emergency' ? '#BB0000' : ''}" src="{path: 'mEquipmentDetail>workOrderPriority', formatter : '.formatter.fnIconBasedPriority'}"></core:Icon>
								<Text text="{mEquipmentDetail>workOrderPriority}"/>
							</HBox>
							<Text text="{mEquipmentDetail>workOrderProgress}"/>
							<Text text="{mEquipmentDetail>workOrderStatus}"/>
							<Text text="{mEquipmentDetail>workOrderStartEndDate}"/>
							<Text visible="false" text="{mEquipmentDetail>workOrderStartDate}"/>
							<Text visible="false" text="{mEquipmentDetail>workOrderEndDate}"/>
						</cells>
					</ColumnListItem>
				</items>
