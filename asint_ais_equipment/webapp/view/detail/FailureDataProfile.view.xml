<mvc:View xmlns:core="sap.ui.core"
	controllerName="com.asint.ais.mi.equipment.controller.detail.Assignments"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<l:VerticalLayout>
		<l:content>
			<Table id="idTableFailureDataProfile" growing="true" growingScrollToLoad="false"
				growingThreshold="5" mode="MultiSelect"
				noDataText="No Data" popinLayout="GridLarge" alternateRowColors="true"
				items="{ path:'mEquipmentDetail>/data/assignments/failureDataProfile/profileList'}"
				selectionChange="onFailureDataProfileSelect">
				<headerToolbar>
					<OverflowToolbar design="Transparent">
                            <Title
                                text="{mEquipmentDetail>/data/assignments/failureDataProfile/profileTableHeader}"
                                level="H2"
                            />
						<ToolbarSpacer />
						<SearchField placeholder="{i18n>asint.equipment.tab.assignments.objectTemplate.search.placeholder.text}" tooltip="{i18n>asint.equipment.tab.assignments.objectTemplate.search.tooltip.text}" width="30%" liveChange="onSearchFailureDataProfile"/>
						<Button type="Emphasized" text="{i18n>asint.reusable.button.assign.text}"
							enabled="{mEquipmentDetail>/metadata/enabled/assign}"
							visible="{=${mEquipmentDetail>/metadata/status/isUnpublished} &amp;&amp; ${mEquipmentDetail>/data/userRoles/edit} }"
							press="onAssignFailureDataProfile" />
						<Button text="{i18n>asint.reusable.button.unassign.text}"
							enabled="{mEquipmentDetail>/metadata/enabled/unassign}"
							visible="{=${mEquipmentDetail>/metadata/status/isUnpublished} &amp;&amp; ${mEquipmentDetail>/data/userRoles/edit} }"
							press="onUnassignFailureDataProfile" />
						<Button icon="sap-icon://sort"
							tooltip="{i18n>asint.equipment.tab.sort.text}"
							press="onSortFailureDataProfile" />
					</OverflowToolbar>
				</headerToolbar>
                <columns>
                    <Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Middle">
                        <Text text="{i18n>asint.equipment.tab.failureDataProfile.profileId.label}" />
                    </Column>
                    <Column demandPopin="true" popinDisplay="Inline" minScreenWidth="Tablet" vAlign="Middle">
                        <Text text="{i18n>asint.equipment.tab.failureDataProfile.profileDescription.label}" />
                    </Column>
                </columns>
				<items>
					<ColumnListItem>
                        <cells>

                            <Text text="{mEquipmentDetail>displayIdNumber}" />
                            <Text text="{mEquipmentDetail>displayId}" />

                        </cells>    
					</ColumnListItem>
				</items>
			</Table>
		</l:content>
	</l:VerticalLayout>
</mvc:View>