<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns:tnt="sap.tnt"
    xmlns:ui="sap.ui.table"
    xmlns:cc="com.asint.ais.library.control.CustomControl"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns="sap.m">
    <Dialog contentHeight="60%" contentWidth="30%" title="{i18n>workflow.create.dialog.header.text}" afterOpen="onWorkflowDialogOpen" draggable="true">
        <customHeader>
            <Toolbar>
                <Title text="{i18n>workflow.create.dialog.header.text}"/>
                <ToolbarSpacer />
                <Button icon="sap-icon://resize" press="onResize"/>
            </Toolbar>
        </customHeader>
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false" ariaLabelledBy="Title1"> -->
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false" ariaLabelledBy="Title1">
                    <f:content>
                        <core:Title text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.header.text}" />
                        <Label required="true" text="{i18n>library.reusable.field.name.text}" />
                        <Input required="true" value="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/name}" />
                        <Label design="Bold" text="{= ${i18n>workflow.asdMultilevelBulkApproval.create.dialog.asd.text} + ' (' + (${mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/passedCount} || 0) + ')' }" />
                        <!-- <ui:Table visibleRowCountMode="Auto" rows="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/aSDItems}" selectionMode="None">
                            <ui:columns>
                                <ui:Column width="10rem">
                                    <Label text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.column.asd.text}" />
                                    <ui:template>
                                        <Link target="_blank" text="{mWorkflow>aSD}" href="{mWorkflow>aSDLink}" />
                                    </ui:template>
                                </ui:Column>
                                <ui:Column width="10rem">
                                    <Label text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.column.description.text}" />
                                    <ui:template>
                                        <ExpandableText text="{mWorkflow>description}" maxCharacters="15" overflowMode="Popover"/>
                                    </ui:template>
                                </ui:Column>
                            </ui:columns>
                        </ui:Table> -->
                        <cc:WorkflowAsmtStgTable width="100%" rows="{path:'mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/treeTableData', parameters: {arrayNames:['nodes']}}" selectionMode="MultiToggle" enableSelectAll="false" visibleRowCount="10" expandFirstLevel="true" columnOrder="Start Date,Due Date,SHE Risk at Due Date,FIN Risk at Due Date,SHE MR at Due Date,FIN MR at Due Date,SHE at Base E,FIN at Base E,E Through,SHE at Base D,FIN at Base D,D Through,SHE at Base C,FIN at Base C,C Through,SHE at Base B,FIN at Base B,B Through,SHE at Base A,FIN at Base A,Base POF at Target Date,Target Date Driver,Backstop Date,Type,Sub Type">
                            <cc:layoutData>
                                <l:GridData span="XL12 L12 M12 S12" />
                            </cc:layoutData>
                        </cc:WorkflowAsmtStgTable>
                        <Label text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.column.createStrategiesAs.text}" />
                        <Select selectedKey="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/createStrategiesAs}">
                            <items>
                                <core:Item key="Recommendation" text="Recommendation" />
                                <core:Item key="Notification" text="Notification" />
                            </items>
                        </Select>
                        <Label text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.noOfLevels.text}" />
                        <StepInput width="20%" textAlign="Center" min="0" max="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/maxLevelAllowed}" value="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/noOfLevels}" change="onCreateASDBulkApprovalLevelChange" />
                        <Text text="{= ${mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/noOfLevels} === 0 ? ${i18n>workflow.asdMultilevelBulkApproval.create.dialog.systemApproved.text} : ${i18n>workflow.asdMultilevelBulkApproval.create.dialog.approverSelection.text}}" />
                        <Label />
                        <Table class="sapUiTinyMarginTopBottom" visible="{= ${mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/noOfLevels} &gt; 0}" items="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/levelsAndApprovers}">
                            <columns>
                                <Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" hAlign="Begin">
                                    <Text text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.level.text}" />
                                </Column>
                                <Column width="70%">
                                    <Text text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.approver.text}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem vAlign="Middle">
                                    <cells>
                                        <Label text="{mWorkflow>level}" />
                                        <Input  valueHelpOnly="true" value="{mWorkflow>approver}" placeholder="{i18n>library.reusable.email.text}" showValueHelp="true" valueHelpRequest="onApproverValueHelp($event,'SingleSelectMaster')" change="onCreateASDBulkApprovalLevelChange" valueState="{path: 'mWorkflow>approver', formatter: '.fnValidateEmail'}" showValueStateMessage="false">
                                        </Input>
                                        <!-- <Input value="{mWorkflow>approver}" placeholder="{i18n>library.reusable.email.text}" change="onCreateASDBulkApprovalLevelChange" valueState="{path: 'mWorkflow>approver', formatter: '.fnValidateEmail'}" showValueStateMessage="false" /> -->
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Label />
                        <CheckBox text="{i18n>library.reusable.notifyByEmail.text}" selected="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/notifyByEmail}" />
                        <Label text="{i18n>workflow.asdMultilevelBulkApproval.create.dialog.comments.text}" required="true"/>
                        <TextArea rows="4" showExceededText="true" maxLength="5000" growing="true" growingMaxLines="15" showValueStateMessage="false" required="true" value="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/comments}" liveChange="onCommentLiveChange"/>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <buttons>
            <Button type="Emphasized" enabled="{mWorkflow>/create/asdMultilevelBulkApprovalWorkflow/enableCreateButton}" text="{i18n>library.reusable.create.button.text}" press="onASDBulkApprovalCreatePress" />
            <Button type="Transparent" text="{i18n>library.reusable.cancel.button.text}" press="onASDBulkApprovalCancelPress" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>