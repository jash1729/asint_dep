<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <Dialog contentHeight="60%" contentWidth="30%" title="{i18n>workflow.create.dialog.header.text}" afterOpen="onWorkflowDialogOpen" draggable="true">
        <customHeader>
            <Toolbar>
                <Title text="{i18n>workflow.create.dialog.header.text}"/> 
                <ToolbarSpacer />
                <Button icon="sap-icon://resize" press="onResize"/>
            </Toolbar>
        </customHeader>
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false" ariaLabelledBy="Title1"> -->
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false" ariaLabelledBy="Title1">
                    <f:content>
                        <core:Title text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.header.text}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.recommendation.text}" />
                        <Input editable="false" type="Text" value="{mWorkflow>/create/recommendationMultiLevelDeferral/recommendation}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.recommendationId.text}" />
                        <Input editable="false" type="Text" value="{mWorkflow>/create/recommendationMultiLevelDeferral/recommendationId}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.recommendationType.text}" />
                        <Input editable="false" type="Text" value="{mWorkflow>/create/recommendationMultiLevelDeferral/recommendationType}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.recommendationSubtype.text}" />
                        <Input editable="false" type="Text" value="{mWorkflow>/create/recommendationMultiLevelDeferral/recommendationSubtype}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.assessmentId.text}" />
                        <Input editable="false" type="Text" value="{mWorkflow>/create/recommendationMultiLevelDeferral/assessmentID}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.dueDate.text}" />
                        <DatePicker editable="false" width="100%"
                            value="{path: 'mWorkflow>/create/recommendationMultiLevelDeferral/dueDate'}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="MMM dd, yyyy"
                            minDate="{path: 'mWorkflow>/create/recommendationMultiLevelDeferral/validFrom', formatter: '.fnFormatMinDate'}"
                        ></DatePicker>  
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.sheRiskAtDueDate.text}" />
                        <Input editable="false" type="Text" value="{mWorkflow>/create/recommendationMultiLevelDeferral/sheRiskAtDueDate}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.finRiskAtDueDate.text}" />
                        <Input editable="false" type="Text" value="{mWorkflow>/create/recommendationMultiLevelDeferral/finRiskAtDueDate}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.regulatory.text}" />
                        <Switch state="{mWorkflow>/create/recommendationMultiLevelDeferral/regulatory}" customTextOn=" " customTextOff=" " enabled="true"/>
                        <!-- add due date picker add valid to validation also -->
                        <Label required="true" text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.proposedDueDate.text}" />
                        <DatePicker width="100%"
                            value="{path: 'mWorkflow>/create/recommendationMultiLevelDeferral/proposedDueDate'}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="MMM dd, yyyy"
                            minDate="{path: 'mWorkflow>/create/recommendationMultiLevelDeferral/validFrom', formatter: '.fnFormatMinDate'}"
                            change="fnValidateBPAFormField"
                        ></DatePicker>  
                        <Button type="Emphasized" text="{i18n>library.reusable.calculatedProposedRisk.button.text}" press="onDeferralCalcProposedRisk($event, 'RECO')"
                            customData:keyMap="{
                                'objectId': 'recommendationGuid',
                                'proposedDueDate': 'proposedDueDate',
                                'proposedSheRiskAtDueDate': 'proposedSHERiskAtDueDate',
                                'proposedFinRiskAtDueDate': 'proposedFINRiskAtDueDate'
                            }">
                            <customData>
                                <core:CustomData key="bindingInfo" value="{mWorkflow>/create/recommendationMultiLevelDeferral}" />
                            </customData>
                        </Button>
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.proposedSheRiskAtDueDate.text}" />
                        <ComboBox items="{path: 'mWorkflow>/config/riskData'}" customData:useGetBinding="true" selectedKey="{mWorkflow>/create/recommendationMultiLevelDeferral/proposedSHERiskAtDueDate}" change="fnValidateBPAFormField">
                            <core:Item key="{mWorkflow>risk}" text="{mWorkflow>risk}" />
		                </ComboBox>
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.proposedFinRiskAtDueDate.text}" />
                        <ComboBox items="{path: 'mWorkflow>/config/riskData'}" customData:useGetBinding="true" selectedKey="{mWorkflow>/create/recommendationMultiLevelDeferral/proposedFINRiskAtDueDate}" change="fnValidateBPAFormField">
                            <core:Item key="{mWorkflow>risk}" text="{mWorkflow>risk}" />
		                </ComboBox>            
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.noOfLevels.text}"/>
                        <StepInput width="20%" textAlign="Center" min="0" max="{mWorkflow>/create/recommendationMultiLevelDeferral/maxLevelAllowed}" value="{mWorkflow>/create/recommendationMultiLevelDeferral/noOfLevels}" change="onCreateRWBMultiLevelDeferralLevelChange"/>
                        <Text text="{= ${mWorkflow>/create/recommendationMultiLevelDeferral/noOfLevels} === 0 ? ${i18n>workflow.recommendationMultiLevelDeferral.create.dialog.systemApproved.text} : ${i18n>workflow.recommendationMultiLevelDeferral.create.dialog.approverSelection.text}}" />
                        <Table class="sapUiTinyMarginTopBottom" visible="{= ${mWorkflow>/create/recommendationMultiLevelDeferral/noOfLevels} &gt; 0}" items="{mWorkflow>/create/recommendationMultiLevelDeferral/levelsAndApprovers}">
                            <columns>
                                <Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" hAlign="Begin">
                                    <Text text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.level.text}" />
                                </Column>
                                <Column width="70%">
                                    <Text text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.approver.text}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem vAlign="Middle">
                                    <cells>
                                        <Label text="{mWorkflow>level}"/>
                                        <Input value="{mWorkflow>approver}" showValueHelp="true" valueHelpRequest="onApproverValueHelp($event,'SingleSelectMaster')" placeholder="{i18n>library.reusable.email.text}" change="onCreateRWBMultiLevelDeferralLevelChange" valueState="{path: 'mWorkflow>approver', formatter: '.fnValidateEmail'}" showValueStateMessage="false" valueHelpOnly="true"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Label />
                        <CheckBox text="{i18n>library.reusable.notifyByEmail.text}" selected="{mWorkflow>/create/recommendationMultiLevelDeferral/notifyByEmail}" />
                        <Label text="{i18n>workflow.recommendationMultiLevelDeferral.create.dialog.comments.text}" required="true"/>
                        <TextArea showExceededText="true" maxLength="5000" growing="true" growingMaxLines="15" rows="4" value="{mWorkflow>/create/recommendationMultiLevelDeferral/comments}" showValueStateMessage="false" required="true" liveChange="onCommentLiveChange"/>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <buttons>
            <Button type="Emphasized" enabled="{mWorkflow>/create/recommendationMultiLevelDeferral/enableCreateButton}" text="{i18n>library.reusable.create.button.text}" press="onRWBMultiLevelDeferralCreatePress"/>
            <Button type="Transparent" text="{i18n>library.reusable.cancel.button.text}" press="onRWBMultiLevelDeferralCancelPress"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>