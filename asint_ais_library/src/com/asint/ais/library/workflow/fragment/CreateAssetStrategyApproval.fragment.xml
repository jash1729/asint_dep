<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns="sap.m">
    <Dialog contentHeight="60%" contentWidth="30%" title="{i18n>workflow.create.dialog.header.text}" afterOpen="onWorkflowDialogOpen" draggable="true">
        <customHeader>
            <Toolbar>
                <Title text="{i18n>workflow.create.dialog.header.text}"/> 
                <ToolbarSpacer />
                <Button icon="sap-icon://resize" press="onResize"/>
            </Toolbar>
        </customHeader>
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false" ariaLabelledBy="Title1"> -->
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false" ariaLabelledBy="Title1">
                    <f:content>
                        <core:Title text="{i18n>workflow.assetStrategyApproval.create.dialog.header.text}"/>
                        <Label text="{i18n>workflow.assetStrategyApproval.create.dialog.assessment.text}"/>
                        <Input editable="false" type="Text" value="{mWorkflow>/create/assetStrategyApproval/assessment}"/>
                        <Label text="{i18n>workflow.assetStrategyApproval.create.dialog.assessmentId.text}"/>
                        <Input editable="false" type="Text" value="{mWorkflow>/create/assetStrategyApproval/assessmentId}"/>
                        <Label text="{i18n>workflow.assetStrategyApproval.create.dialog.reviewer.text}"/>
                        <Input value="{mWorkflow>/create/assetStrategyApproval/reviewer}" placeholder="{i18n>library.reusable.email.text}"/>
                        <!-- <ComboBox required="true" items="{mWorkflow>/userList}" selectedKey="{mWorkflow>/create/assetStrategyApproval/reviewer}">
                            <core:ListItem key="{mWorkflow>email}" text="{mWorkflow>name}" />
                        </ComboBox> -->
                        <Label text="{i18n>workflow.assetStrategyApproval.create.dialog.comments.text}"/>
                        <TextArea showExceededText="true" maxLength="5000" growing="true" growingMaxLines="15" rows="4" value="{mWorkflow>/create/assetStrategyApproval/comments}" liveChange="onCommentLiveChange" />
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <buttons>
            <Button type="Emphasized" text="{i18n>library.reusable.create.button.text}" press="onAssetStrategyApprovalCreatePress"/>
            <Button type="Transparent" text="{i18n>library.reusable.cancel.button.text}" press="onAssetStrategyApprovalCancelPress"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>