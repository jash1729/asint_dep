<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        title="{i18n>library.reusable.selectUser}"
        contentWidth="50%"
        contentHeight="60%"
        stretchOnPhone="true"
        draggable="true"
        resizable="true">
        <content>
            <VBox width="100%">
                <Toolbar>
                    <ToolbarSpacer/>
                    <SearchField
                        id="idGenericSearchField"
                        width="40%"
                        placeholder="{i18n>library.reusable.searchNameEmail}"
                        search="onValueHelpSearch"/>
                </Toolbar>
                <Table
                    id="GenericvalueHelpTable"
                    width="100%"
                    mode="{mWorkflow>/createWorkFLow/mode}"
                    rememberSelections="true"
                    growing="true"
                    growingScrollToLoad="true"
                    growingThreshold="20"
                    alternateRowColors="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    busyIndicatorDelay="0"
                    noDataText="{i18n>library.reusable.noDataFound.text}"
                    items="{
                        path: 'valueHelpService>/UserList',
                        parameters: {
                            $select: 'ID,userName,name'
                        }
                    }"> 
                    <columns>
                        <Column width="45%">
                            <Text text="{i18n>library.reusable.email.text}"/>
                        </Column>
                        <Column width="45%">
                            <Text text="{i18n>library.reusable.field.name.text}"/>
                        </Column>
                    </columns>

                    <items>

                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text text="{valueHelpService>userName}"/>
                                <Text text="{valueHelpService>name}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <buttons>
            <Button
                type="Emphasized"
                text="{i18n>library.reusable.confirm.button.text}"
                press="onConfrimValueHelpDialog"/>
            <Button
                type="Transparent"
                text="{i18n>library.reusable.cancel.button.text}"
                press="onCloseValueHelpDialog"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>