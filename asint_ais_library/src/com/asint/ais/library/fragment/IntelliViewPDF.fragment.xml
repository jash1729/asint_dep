<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="idIntelliViewPDFDialog" title="{i18n>asint.intelli.intelliView.dialog.title}" draggable="true" resizable="false" verticalScrolling="false" horizontalScrolling="false" class="intelliViewDialog" contentWidth="80vh">

        <VBox width="100%" height="100%" class="intelliViewRoot">
            <OverflowToolbar height="3rem">
                <ToolbarSpacer/>

                <Button id="idPDFViewZoomOutBtn"   icon="sap-icon://zoom-out" text="{i18n>asint.intelli.toolbar.zoomOut.text}"   press="onPDFViewZoomOut"/>
                <Button id="idPDFViewZoomInBtn"    icon="sap-icon://zoom-in"  text="{i18n>asint.intelli.toolbar.zoomIn.text}"    press="onPDFViewZoomIn"/>
                <Button id="idPDFViewResetZoomBtn" icon="sap-icon://reset"    text="{i18n>asint.intelli.toolbar.reset.text}"     press="onPDFResetZoom"/>
            </OverflowToolbar>

            <HBox justifyContent="Center" alignItems="Center" height="2.5rem" class="sapUiSmallMarginTopBottom">
                <Button id="idPDFViewPrevPageBtn" icon="sap-icon://navigation-left-arrow" press="onPDFViewPrevPage" enabled="false"/>
                <Text id="idPDFViewPageIndicator" text="Page 1 / 1" class="sapUiSmallMarginBeginEnd"/>
                <Button id="idPDFViewNextPageBtn" icon="sap-icon://navigation-right-arrow" press="onPDFViewNextPage" enabled="false"/>
            </HBox>

            <ScrollContainer id="idPDFViewerScroll" width="100%" height="80%" horizontal="true" vertical="true" class="intelliViewCanvasWrapper">
                <VBox width="100%" height="100%" justifyContent="Center" alignItems="Center" class="imageContainer">
                    <core:HTML id="idPDFViewCanvasHost" sanitizeContent="false" content=""/>
                </VBox>
            </ScrollContainer>
        </VBox>

        <buttons>
            <Button text="{i18n>asint.intelli.intelliView.dialog.button.close.text}" type="Emphasized" press="onClosePDFIntelliView"/>
        </buttons>

    </Dialog>
</core:FragmentDefinition>