<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="{i18n>valueHelpFragment.failureDataProfile.dialog.title.text}"
        horizontalScrolling="false"
        contentWidth="60%"
        contentHeight="80%"
    >
        <Table
            id="idfailureDataProfileFilterTable"
            growing="true"
            growingScrollToLoad="true"
            growingThreshold="20"
            mode="{mValueHelpFilterModel>/metadata/selectionMode}"
            noDataText="{i18n>library.reusable.noDataFound.text}"
            popinLayout="GridLarge"
            alternateRowColors="true"
            sticky="ColumnHeaders,HeaderToolbar"
            items="{
                path: 's4DataService>/S4Master',
                sorter: {path: 'modifiedAt', descending: true},
                parameters: {
                    $filter: 'objectType eq \'CTPL\''
                }
            }"
            selectionChange="onValueHelpFilterTableSelection($event, 's4DataService')"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <content>
                        <SearchField
                            placeholder="{i18n>library.reusable.search.placeholder.text}"
                            width="100%"
                            search="fnSearchInValueHelpFragmentTable(
                                $event,
                                'idfailureDataProfileFilterTable',
                                ['name', 'description']
                            )"
                        />
                                <!-- ['catalogProfileName', 'catalogProfileDescription'] -->
                    </content>
                </OverflowToolbar>
            </headerToolbar>

            <columns>
                <Column>
                    <Text text="{i18n>valueHelpFragment.failureDataProfile.dialog.table.column.failureDataProfileName}" />
                </Column>

                <Column>
                    <Text text="{i18n>valueHelpFragment.failureDataProfile.dialog.table.column.failureDataProfileDesc}" />
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{s4DataService>name}" />
                        <Text text="{s4DataService>description}" />
                        <!-- <Text text="{}" /> -->
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <buttons>
            <Button
                text="{i18n>library.reusable.confirm.button.text}"
                type="Emphasized"
                press="onConfirmValueHelpFilter(
                    'idfailureDataProfileFilterTable',
                    'name',
                    'description'
                )"
                visible="{= ${mValueHelpFilterModel>/metadata/selectionMode} === 'MultiSelect'}"
            />
            <Button
                text="{i18n>library.reusable.close.button.text}"
                press="onCancelValueHelpFilter('idfailureDataProfileFilterTable')"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>