                            <f:SimpleForm id="idCreateAdHocCMLForm" editable="true">
                                <f:content>
                                    <Label required="true" text="{i18n>asint.detail.tab.cml.createAdHocCML.dialog.name.text}"/>
                                    <Input value="{mCMLData>/data/tab/cml/createAdHocCml/name}"/>
                                    <Label required="true" text="{i18n>asint.detail.tab.cml.createAdHocCML.dialog.description.text}"/>
                                    <Input value="{mCMLData>/data/tab/cml/createAdHocCml/description}"/>
                                </f:content>
                            </f:SimpleForm>
                        </content>
                        <footer>
                            <Toolbar>
                                <ToolbarSpacer/>
                                <Button type="Emphasized" text="{i18n>asint.reusable.button.create.text}" press="onCreateAdHocCMLConfirm"/>
                                <Button text="{i18n>asint.reusable.button.cancel.text}" press="onCreateAdHocCMLCancel"/>
                            </Toolbar>
                        </footer>
                    </Page> -->
                </pages>
            </NavContainer>
        </content>
    </Dialog>
</core:FragmentDefinition>