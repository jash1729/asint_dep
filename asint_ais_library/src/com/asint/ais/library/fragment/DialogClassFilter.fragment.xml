<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="{i18n>valueHelpFragment.class.dialog.title.text}"
        horizontalScrolling="false"
        contentWidth="60%"
        contentHeight="80%"
    >
            <!-- mode="MultiSelect" -->
        <Table
            id="idClassFilterTable"
            growing="true"
            growingScrollToLoad="true"
            growingThreshold="20"
            mode="{mValueHelpFilterModel>/metadata/selectionMode}"
            noDataText="{i18n>library.reusable.noDataFound.text}"
            popinLayout="GridLarge"
            alternateRowColors="true"
            sticky="ColumnHeaders,HeaderToolbar"
            items="{
                path: 'masterDataService>/ClassValueHelp',
                parameters : {
                    $select: 'ID,classType,classTypeName',
                    countMode: 'Inline'
                }
            }"
            selectionChange="onValueHelpFilterTableSelection($event, 'masterDataService')"
        >
                <!-- sorter: {path: 'modifiedAt', descending: true} -->
                    <!-- $expand: 'to_description', -->
            <headerToolbar>
                <OverflowToolbar>
                    <content>
                        <SearchField
                            id="idClassFilterSearchField"
                            placeholder="{i18n>library.reusable.search.placeholder.text}"
                            width="100%"
                            search="fnSearchInValueHelpFragmentTable(
                                $event,
                                'idClassFilterTable',
                                ['name', 'classTypeName', 'shortDescription'],
                                'idClassFilterSearchField'
                            )"
                        />
                    </content>
                </OverflowToolbar>
            </headerToolbar>

            <columns>
                <Column>
                    <Text text="{i18n>valueHelpFragment.class.dialog.table.column.class}" />
                </Column>

                <Column>
                    <Text text="{i18n>valueHelpFragment.class.dialog.table.column.classType}" />
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <VBox>
                            <!-- <Text text="{masterDataService>to_description/0/shortDescription}" /> -->
                            <Text text="{masterDataService>shortDescription}" />
                            <Text
                                text="{
                                    path: 'masterDataService>name',
                                    formatter: '.formatter.fnFormatName'
                                }"
                            />
                        </VBox>
                        <Text text="{masterDataService>classTypeName}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <buttons>
            <Button
                text="{i18n>library.reusable.confirm.button.text}"
                type="Emphasized"
                press="onConfirmValueHelpFilter(
                    'idClassFilterTable',
                    'name',
                    'name'
                )"
                visible="{= ${mValueHelpFilterModel>/metadata/selectionMode} === 'MultiSelect'}"
            />
            <Button
                text="{i18n>library.reusable.close.button.text}"
                press="onCancelValueHelpFilter('idClassFilterTable')"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
