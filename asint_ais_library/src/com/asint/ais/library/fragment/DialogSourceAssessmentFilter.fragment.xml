<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="{i18n>valueHelpFragment.sourceAssessment.dialog.title.text}"
        horizontalScrolling="false"
        contentWidth="60%"
        contentHeight="80%"
    >
        <Table
            id="idSourceAssessmentFilterTable"
            growing="true"
            growingScrollToLoad="true"
            growingThreshold="20"
            mode="MultiSelect"
            noDataText="{i18n>library.reusable.noDataFound.text}"
            popinLayout="GridLarge"
            alternateRowColors="true"
            sticky="ColumnHeaders,HeaderToolbar"
            items="{ path: 'assetReliabilityService>/GenClassStrategyAssessmentsList', sorter: {path: 'modifiedAt', descending: true} }"
            selectionChange="onValueHelpFilterTableSelection($event, 'assetReliabilityService')"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <content>
                        <SearchField
                            placeholder="{i18n>library.reusable.search.placeholder.text}"
                            width="100%"
                            search="fnSearchInValueHelpFragmentTable(
                                $event,
                                'idSourceAssessmentFilterTable',
                                ['name']
                            )"
                        />
                    </content>
                </OverflowToolbar>
            </headerToolbar>

            <columns>
                <Column>
                    <Text text="{i18n>valueHelpFragment.sourceAssessment.dialog.table.column.sourceAssessmentName}" />
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{assetReliabilityService>name}" />
                        <!-- <Text text="{}" /> -->
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <buttons>
            <Button
                text="{i18n>library.reusable.confirm.button.text}"
                type="Emphasized"
                press="onConfirmValueHelpFilter(
                    'idSourceAssessmentFilterTable',
                    'name',
                    'name'
                )"
            />
            <Button
                text="{i18n>library.reusable.close.button.text}"
                press="onCancelValueHelpFilter('idSourceAssessmentFilterTable')"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>